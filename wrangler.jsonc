{
  // Konfiguracja wdrożenia na Cloudflare Workers.
  // Bez tego pliku `npx wrangler deploy` z panelu nie ma czego wdrożyć.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tomasz-marek",
  "compatibility_date": "2026-08-04",

  // Strony publiczne są nadal prerenderowane i serwowane jako pliki statyczne.
  // Worker obsługuje wyłącznie trasy renderowane na żądanie: podgląd wersji
  // roboczych pod /preview oraz przełączanie trybu podglądu pod /api/draft-mode.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_flags": ["nodejs_compat"]
}
