---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  heading?: string;
  description?: string;
  // wide — nagłówek na pełnej szerokości (dla treści spoza kontenera 1100px)
  wide?: boolean;
}

const { title, heading, description, wide = false } = Astro.props;
---

<Base title={title} description={description}>
  <Header />

  <main class="page section-spaced">
    {
      heading && (
        <div class={wide ? 'section' : 'container'}>
          <h1 class="page__title">{heading}</h1>
        </div>
      )
    }
    <slot />
  </main>

  <Footer />
</Base>

<style>
  .page__title {
    margin-bottom: var(--space-16);
    font-size: var(--h3);
    line-height: 1.125;
    letter-spacing: var(--tracking-heading);
    font-weight: 400;
  }

  @media (max-width: 1024px) {
    .page__title {
      margin-bottom: var(--space-8);
    }
  }
</style>
