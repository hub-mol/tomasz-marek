---
import '../styles/global.css';
import '@fontsource-variable/work-sans/wght.css';
import '@fontsource-variable/dm-sans/wght.css';
import dmSansUrl from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import workSansUrl from '@fontsource-variable/work-sans/files/work-sans-latin-wght-normal.woff2?url';
import {getHomePage, getSiteSettings} from '../data/site';
import {VisualEditing} from '@sanity/astro/visual-editing';
import {bezZnacznikow} from '../lib/sanityLoad';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  socialImage?: string;
  contentType?: 'website' | 'article';
  author?: string;
  publishedAt?: string;
  noindex?: boolean;
}

const preview = Astro.locals.preview ?? false;
const [settings, home] = await Promise.all([getSiteSettings({preview}), getHomePage({preview})]);
const siteUrl = new URL('/', Astro.site ?? 'https://tomaszmarek.com').toString();
const {
  title = settings.defaultSeoTitle,
  description = settings.defaultSeoDescription,
  canonical = Astro.url.pathname,
  socialImage = home.heroImages[0]?.url ?? new URL('/img/tm-1.jpg', siteUrl).toString(),
  contentType = 'website',
  author,
  publishedAt,
  noindex = false,
} = Astro.props;
// Tytuł i opisy trafiają do <title> i <meta>, gdzie znaczniki stega byłyby
// niewidzialnym śmieciem — czyścimy je centralnie dla wszystkich podstron.
const metaTitle = bezZnacznikow(title);
const metaDescription = bezZnacznikow(description);
const metaImage = bezZnacznikow(socialImage);
const canonicalUrl = new URL(canonical, siteUrl).toString();
const sameAs = [settings.instagram, settings.facebook, settings.iarpUrl].filter(Boolean);

const professionalService = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${siteUrl}#professional-service`,
  name: settings.siteTitle,
  alternateName: 'TMA',
  url: siteUrl,
  email: settings.email,
  telephone: settings.phoneHref,
  ...(settings.nip ? {taxID: settings.nip} : {}),
  ...(settings.regon ? {
    identifier: {
      '@type': 'PropertyValue',
      propertyID: 'REGON',
      value: settings.regon,
    },
  } : {}),
  ...(settings.studioStreet && settings.studioPostalCode && settings.studioCity ? {
    address: {
      '@type': 'PostalAddress',
      streetAddress: settings.studioStreet,
      postalCode: settings.studioPostalCode,
      addressLocality: settings.studioCity,
      ...(settings.studioRegion ? {addressRegion: settings.studioRegion} : {}),
      addressCountry: settings.studioCountry ?? 'PL',
    },
  } : {}),
  ...(settings.founderName ? {
    founder: {
      '@type': 'Person',
      name: settings.founderName,
      jobTitle: 'Architekt',
      ...(settings.iarpNumber ? {
        hasCredential: {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'Wpis na listę członków Izby Architektów RP',
          identifier: {
            '@type': 'PropertyValue',
            propertyID: 'IARP',
            value: settings.iarpNumber,
          },
          recognizedBy: {
            '@type': 'Organization',
            name: 'Izba Architektów Rzeczypospolitej Polskiej',
            url: 'https://www.izbaarchitektow.pl/',
          },
        },
      } : {}),
    },
  } : {}),
  ...(settings.areaServed?.length ? {areaServed: settings.areaServed} : {}),
  ...(sameAs.length ? {sameAs} : {}),
};

const professionalServiceJsonLd = JSON.stringify(bezZnacznikow(professionalService)).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content={contentType} />
    <meta property="og:site_name" content={settings.siteTitle} />
    <meta property="og:title" content={metaTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={metaImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}
    <meta name="twitter:image" content={metaImage} />
    {contentType === 'article' && author && <meta property="article:author" content={author} />}
    {contentType === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <script type="application/ld+json" set:html={professionalServiceJsonLd} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link
      rel="preload"
      href={dmSansUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={workSansUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />

    {preview && (
      <>
        <VisualEditing enabled />
        <a class="preview-exit" href="/api/draft-mode/disable">Wyjdź z podglądu</a>
        <script is:inline>
          // W podglądzie odsyłacze wewnętrzne muszą zostać w gałęzi /preview,
          // inaczej klik wyrzuca edytora na wersję opublikowaną.
          for (const link of document.querySelectorAll('a[href^="/"]')) {
            const href = link.getAttribute('href');
            if (!href || href.startsWith('/preview') || href.startsWith('/api/') || href.startsWith('/admin')) continue;
            link.setAttribute('href', href === '/' ? '/preview' : '/preview' + href);
          }
        </script>
      </>
    )}
  </body>
</html>

<style is:global>
  .preview-exit {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 9999;
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    background: #2b2a26;
    color: #fff;
    font: inherit;
    font-size: 0.8125rem;
    text-decoration: none;
  }
</style>
