---
import ArticlePage from '../../components/article/ArticlePage.astro';
import {getBlogPosts} from '../../data/blogPosts';

export async function getStaticPaths() {
  const posts = await getBlogPosts('offer');
  return posts.map((post, index) => ({
    params: {slug: post.slug},
    props: {
      post,
      prev: posts.length > 1 ? posts[(index - 1 + posts.length) % posts.length] : undefined,
      next: posts.length > 1 ? posts[(index + 1) % posts.length] : undefined,
    },
  }));
}

const {post, prev, next} = Astro.props;
---

<ArticlePage post={post} prev={prev} next={next} />
