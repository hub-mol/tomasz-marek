---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectNav from '../../components/project/ProjectNav.astro';
import ProjectEditorial from '../../components/project/ProjectEditorial.astro';
import ProjectImmersive from '../../components/project/ProjectImmersive.astro';
import ProjectMosaic from '../../components/project/ProjectMosaic.astro';
import { getProjects } from '../../data/projects';
import {getImageEdgeColors} from '../../lib/imagePalette';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(index - 1 + projects.length) % projects.length],
      next: projects[(index + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const heroColors = await getImageEdgeColors(project.img);
---

<Base
  title={`${project.title} — Tomasz Marek Architekt`}
  description={`${project.category}. ${project.location}${project.surface ? `, ${project.surface}` : ''}.`}
>
  <Header
    variant="overlay"
    overlayColor={heroColors.navText}
    overlayColorMobile={heroColors.mobileNavText}
  />

  <main>
    {project.layout === 'editorial' && <ProjectEditorial project={project} />}
    {project.layout === 'immersive' && <ProjectImmersive project={project} />}
    {project.layout === 'mosaic' && <ProjectMosaic project={project} />}

    <ProjectNav prev={prev} next={next} />
  </main>

  <Footer />
</Base>
