---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import Hero from '../components/sections/Hero.astro';
import Approach from '../components/sections/Approach.astro';
import ProjectsGrid from '../components/sections/ProjectsGrid.astro';
import OfferList from '../components/sections/OfferList.astro';
import Accordion from '../components/sections/Accordion.astro';
import ProcessOverview from '../components/sections/ProcessOverview.astro';
import AboutHero from '../components/sections/AboutHero.astro';

import {getHomePage} from '../data/site';

const home = await getHomePage();
---

<Base
  title={home.seoTitle}
  description={home.seoDescription}
>
  <Header variant="overlay" hideLogo />

  <main>
    <Hero
      text={home.heroLead}
      images={home.heroImages}
    />

    <Approach title={home.approachTitle} body={home.approachBody} callout={home.approachCallout} pillars={home.approachPillars} />

    <ProjectsGrid title={home.projectsTitle} linkLabel={home.projectsLinkLabel} />

    <OfferList title={home.offerTitle} offers={home.offers} />

    {(home.showArchitectureProcess || home.showInteriorsProcess) && (
      <ProcessOverview
        title={home.processTitle}
        architecture={home.showArchitectureProcess ? home.architectureProcess : []}
        interiors={home.showInteriorsProcess ? home.interiorsProcess : []}
      />
    )}

    <AboutHero
      id="o-mnie"
      eyebrow=""
      title={home.aboutTitle}
      titleClass="type-h3"
      leadFirst={false}
      body={home.aboutParagraphs}
      img={home.aboutImage ?? '/img/tm-7.jpg'}
      alt={home.aboutImage?.alt ?? 'Tomasz Marek, architekt'}
    />

    <Accordion
      id="faq"
      eyebrow="FAQ"
      title={home.faqTitle}
      items={home.faq}
      numbered
      alt
    />
  </main>

  <Footer id="kontakt" />
</Base>
