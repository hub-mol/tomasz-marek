---
import Page from '../layouts/Page.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {getProjects} from '../data/projects';

const projects = await getProjects();
---

<Page title="Portfolio — Tomasz Marek" heading="Portfolio" wide noindex>
  <section class="section portfolio-grid">
    {projects.map((project) => <ProjectCard project={project} variant="grid" />)}
  </section>
</Page>

<style>
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(var(--space-8), 4vw, var(--space-16)) var(--space-8);
  }

  @media (max-width: 1024px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
