---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import {getBlogPosts} from '../../data/blogPosts';

const posts = await getBlogPosts();
const dateFormatter = new Intl.DateTimeFormat('pl-PL', {day: 'numeric', month: 'long', year: 'numeric'});
---

<Base title="Blog — Tomasz Marek Architekt" description="Notatki o projektowaniu architektury i wnętrz.">
  <Header />
  <main class="section section-spaced blog-index">
    <header class="blog-index__head">
      <p class="tagline">Blog</p>
      <h1 class="type-h1">O projektowaniu</h1>
    </header>

    <ul class="blog-index__grid">
      {posts.map((post) => (
        <li>
          <article class="blog-card">
            {post.cover && (
              <a class="blog-card__media" href={`/blog/${post.slug}`}>
                <ProjectImage image={post.cover} alt={post.cover.alt ?? post.title} widths={[480, 768, 1100]} sizes="(max-width: 768px) 100vw, 50vw" format="avif" loading="lazy" />
              </a>
            )}
            <p class="tagline">{dateFormatter.format(new Date(post.publishedAt))}{post.categories[0] ? ` · ${post.categories[0]}` : ''}</p>
            <h2 class="type-h3"><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
            <p>{post.excerpt}</p>
          </article>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</Base>

<style>
  .blog-index__head { margin-bottom: var(--space-16); }
  .blog-index__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-16) var(--space-8); }
  .blog-card__media { display: block; margin-bottom: var(--space-6); overflow: hidden; background: var(--c-bg-alt); }
  .blog-card__media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .blog-card h2 { margin-top: var(--space-2); }
  .blog-card > p:last-child { max-width: 58ch; margin-top: var(--space-3); color: var(--c-muted); }
  @media (max-width: 768px) { .blog-index__grid { grid-template-columns: 1fr; } }
</style>
