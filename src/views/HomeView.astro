---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import Hero from '../components/sections/Hero.astro';
import Approach from '../components/sections/Approach.astro';
import ProjectsGrid from '../components/sections/ProjectsGrid.astro';
import OfferList from '../components/sections/OfferList.astro';
import Accordion from '../components/sections/Accordion.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import ProcessOverview from '../components/sections/ProcessOverview.astro';
import AboutHero from '../components/sections/AboutHero.astro';

import {getHomePage} from '../data/site';

const home = await getHomePage({preview: Astro.locals.preview ?? false});
---

<Base
  title={home.seoTitle}
  description={home.seoDescription}
>
  <Header variant={home.showHero ? 'overlay' : 'solid'} hideLogo={home.showHero} />

  <main>
    {home.showHero && <Hero
      text={home.heroLead}
      images={home.heroImages}
      videoUrl={home.heroType === 'video' ? home.heroVideoUrl : undefined}
    />}

    {home.showApproach && <Approach title={home.approachTitle} body={home.approachBody} callout={home.approachCallout} pillars={home.approachPillars} />}

    {home.showProjects && <ProjectsGrid title={home.projectsTitle} linkLabel={home.projectsLinkLabel} />}

    {home.showOffer && <OfferList title={home.offerTitle} offers={home.offers} />}

    {home.showProcess && home.processLayout === 'diagram' && (
      <ProcessSteps heading={home.processTitle} steps={home.nextSteps} />
    )}

    {home.showProcess && home.processLayout === 'accordion' && (home.showArchitectureProcess || home.showInteriorsProcess) && (
      <ProcessOverview
        title={home.processTitle}
        architecture={home.showArchitectureProcess ? home.architectureProcess : []}
        interiors={home.showInteriorsProcess ? home.interiorsProcess : []}
      />
    )}

    {home.showAbout && <AboutHero
      id="o-mnie"
      eyebrow=""
      title={home.aboutTitle}
      titleClass="type-h3"
      leadFirst={false}
      body={home.aboutParagraphs}
      img={home.aboutImage}
      alt={home.aboutImage?.alt ?? 'Projekt domu autorstwa Tomasza Marka'}
    />}

    {home.showFaq && <Accordion
      id="faq"
      title={home.faqTitle}
      items={home.faq}
      numbered
      alt
    />}
  </main>

  <Footer id="kontakt" />
</Base>
