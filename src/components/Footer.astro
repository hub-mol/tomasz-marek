---
import ArrowLink from './ArrowLink.astro';
import BrandLogo from './BrandLogo.astro';
import { plNoBreak } from '../utils/typography';
import {getSiteSettings} from '../data/site';

interface Props {
  id?: string;
}

const { id } = Astro.props;
const year = new Date().getFullYear();
const settings = await getSiteSettings();
const {email, phoneLabel, phoneHref} = settings;
---

<footer class="ftr" id={id}>
  <section class="section section-spaced ftr__contact">
    <p class="tagline">Kontakt</p>

    <div class="ftr__intro">
      <h2 class="type-h2">{settings.footerTitle}</h2>
      <p class="text-pretty">{plNoBreak(settings.footerText)}</p>
      <ArrowLink href={`mailto:${email}?subject=Spotkanie z architektem`} typeClass="type-h3">
        {settings.bookingLabel}
      </ArrowLink>
    </div>
  </section>

  <div class="section ftr__details">
    <div class="ftr__brand">
      <a href="/" aria-label={settings.logo}>
        <BrandLogo class="ftr__logo" />
      </a>
    </div>

    <address class="ftr__block">
      <p class="ftr__label tagline">Pracownia</p>
      {settings.studioAddress.map((line, index) => <p class:list={{'ftr__entity': index === 1}}>{line}</p>)}
    </address>

    <address class="ftr__block">
      <p class="ftr__label tagline">Siedziba</p>
      {settings.businessAddress.map((line) => <p>{line}</p>)}
      {settings.nip && <p class="ftr__spacer">NIP: {settings.nip}</p>}
      {settings.regon && <p>REGON: {settings.regon}</p>}
    </address>

    <div class="ftr__block">
      <p class="ftr__label tagline">Kontakt</p>
      <p><a href={`mailto:${email}`}>{email}</a></p>
      <p><a href={`tel:${phoneHref}`}>{phoneLabel}</a></p>
      {settings.instagram && <p class="ftr__spacer"><a href={settings.instagram} target="_blank" rel="noreferrer">Instagram</a></p>}
      {settings.facebook && <p><a href={settings.facebook} target="_blank" rel="noreferrer">Facebook</a></p>}
    </div>
  </div>

  <div class="section ftr__bottom type-body-sm">
    <p>&copy; {year} {settings.logo} {settings.siteTitle}</p>
    <p>Wdrożenie i projekt: <a href="https://molenda.dev" target="_blank" rel="noreferrer">molenda.dev</a></p>
  </div>
</footer>

<style>
  .ftr {
    background: var(--c-bg-dark);
    color: var(--c-on-dark);
  }

  .ftr__contact {
    display: grid;
    grid-template-columns: minmax(17.5rem, 1fr) minmax(0, 1.6fr);
    gap: clamp(var(--space-16), 8vw, var(--space-32));
  }

  .ftr__contact > .tagline {
    padding-top: var(--space-2);
    color: color-mix(in srgb, var(--c-on-dark) 55%, transparent);
  }

  .ftr__intro h2 {
    max-width: 53.75rem;
  }

  .ftr__intro > p {
    max-width: 60ch;
    margin-top: var(--space-8);
    color: color-mix(in srgb, var(--c-on-dark) 67%, transparent);
  }

  .ftr__intro :global(.arrow-link) {
    margin-top: var(--space-24);
  }

  .ftr__details {
    display: grid;
    grid-template-columns: 1.25fr repeat(3, minmax(11.25rem, 1fr));
    gap: var(--space-12);
    padding-block: var(--space-12) var(--space-16);
    border-top: 1px solid color-mix(in srgb, var(--c-on-dark) 25%, transparent);
  }

  :global(.ftr__logo) {
    display: block;
    width: clamp(50%, 50vw, 10rem);
    height: auto;
    line-height: 1;
  }

  @media (width >= 769px) {
    :global(.ftr__logo) {
      padding-top: var(--space-8);
    }
  }

  .ftr__brand p {
    margin-top: var(--space-2);
    color: color-mix(in srgb, var(--c-on-dark) 55%, transparent);
  }

  .ftr__block {
    font-style: normal;
  }

  .ftr__label {
    margin-bottom: var(--space-4);
    color: color-mix(in srgb, var(--c-on-dark) 50%, transparent);
  }

  .ftr__spacer {
    margin-top: var(--space-4);
  }

  .ftr__entity {
    margin-bottom: var(--space-4);
  }

  .ftr__block a {
    transition: color 0.25s ease;
  }

  .ftr__bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid color-mix(in srgb, var(--c-on-dark) 25%, transparent);
    color: color-mix(in srgb, var(--c-on-dark) 50%, transparent);
  }

  @media (max-width: 1024px) {
    .ftr__contact {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .ftr__details {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-16) var(--space-8);
    }
  }

  @media (max-width: 768px) {
    .ftr__bottom {
      flex-direction: column;
    }

    .ftr__contact {
      gap: var(--space-6);
    }

    .ftr__details {
      grid-template-columns: 1fr;
      gap: var(--space-12);
      padding-block: var(--space-12) var(--space-16);
    }
  }
</style>
