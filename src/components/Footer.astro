---
import ArrowLink from './ArrowLink.astro';
import { plNoBreak } from '../utils/typography';

interface Props {
  id?: string;
}

const { id } = Astro.props;
const year = new Date().getFullYear();
const email = 'biuro@tomaszmarek.com';
const phoneLabel = '+48 696 995 899';
const phoneHref = '+48696995899';
---

<footer class="ftr" id={id}>
  <section class="section section-spaced ftr__contact">
    <p class="tagline">Kontakt</p>

    <div class="ftr__intro">
      <h2 class="type-h2">Porozmawiajmy o Twoim projekcie</h2>
      <p class="text-pretty">{plNoBreak('Planujesz budowę, przebudowę albo nowe wnętrze? Opowiedz nam o swojej inwestycji. Podczas pierwszej rozmowy sprawdzimy, w jakim zakresie możemy Ci pomóc.')}</p>
      <ArrowLink href={`mailto:${email}?subject=Spotkanie z architektem`} typeClass="type-h3">
        Umów spotkanie z&nbsp;architektem
      </ArrowLink>
    </div>
  </section>

  <div class="section ftr__details">
    <div class="ftr__brand">
      <a class="ftr__logo type-h2" href="/">TMA</a>
      <p>Tomasz Marek Architekt</p>
    </div>

    <address class="ftr__block">
      <p class="ftr__label tagline">Pracownia</p>
      <p>TMA</p>
      <p class="ftr__entity">Tomasz Marek Architekt</p>
      <p>ul. Magellana 2/29</p>
      <p>80-288 Gdańsk</p>
    </address>

    <address class="ftr__block">
      <p class="ftr__label tagline">Działalność</p>
      <p>Stary Grabiąż 6A</p>
      <p>78-460 Stary Grabiąż</p>
      <p class="ftr__spacer">NIP: 6731917259</p>
      <p>REGON: 528600458</p>
    </address>

    <div class="ftr__block">
      <p class="ftr__label tagline">Kontakt</p>
      <p><a href={`mailto:${email}`}>{email}</a></p>
      <p><a href={`tel:${phoneHref}`}>{phoneLabel}</a></p>
      <p class="ftr__spacer">
        <a href="https://www.instagram.com/studjo.biuro/" target="_blank" rel="noreferrer">Instagram</a>
      </p>
      <p>
        <a href="https://www.facebook.com/people/studjobiuro/100078056002732/" target="_blank" rel="noreferrer">Facebook</a>
      </p>
    </div>
  </div>

  <div class="section ftr__bottom type-body-sm">
    <p>&copy; {year} TMA Tomasz Marek Architekt</p>
    <p>Wdrożenie i projekt: <a href="https://molenda.dev" target="_blank" rel="noreferrer">molenda.dev</a></p>
  </div>
</footer>

<style>
  .ftr {
    background: #171816;
    color: #fff;
  }

  .ftr__contact {
    display: grid;
    grid-template-columns: minmax(17.5rem, 1fr) minmax(0, 1.6fr);
    gap: clamp(var(--space-16), 8vw, var(--space-32));
  }

  .ftr__contact > .tagline {
    padding-top: var(--space-2);
    color: rgba(255, 255, 255, 0.55);
  }

  .ftr__intro h2 {
    max-width: 53.75rem;
  }

  .ftr__intro > p {
    max-width: 60ch;
    margin-top: var(--space-8);
    color: rgba(255, 255, 255, 0.67);
  }

  .ftr__intro :global(.arrow-link) {
    margin-top: var(--space-24);
  }

  .ftr__details {
    display: grid;
    grid-template-columns: 1.25fr repeat(3, minmax(11.25rem, 1fr));
    gap: var(--space-12);
    padding-block: var(--space-12) var(--space-16);
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }

  .ftr__logo {
    line-height: 1;
  }

  .ftr__brand p {
    margin-top: var(--space-2);
    color: rgba(255, 255, 255, 0.55);
  }

  .ftr__block {
    font-style: normal;
  }

  .ftr__label {
    margin-bottom: var(--space-4);
    color: rgba(255, 255, 255, 0.5);
  }

  .ftr__spacer {
    margin-top: var(--space-4);
  }

  .ftr__entity {
    margin-bottom: var(--space-4);
  }

  .ftr__block a {
    transition: color 0.25s ease;
  }

  .ftr__block a:hover {
    color: var(--c-accent);
  }

  .ftr__bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 1024px) {
    .ftr__contact {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .ftr__details {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-16) var(--space-8);
    }
  }

  @media (max-width: 768px) {
    .ftr__bottom {
      flex-direction: column;
    }

    .ftr__contact {
      gap: var(--space-6);
    }

    .ftr__details {
      grid-template-columns: 1fr;
      gap: var(--space-12);
      padding-block: var(--space-12) var(--space-16);
    }
  }
</style>
