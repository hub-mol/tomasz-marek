---
import type {BlogPost} from '../../data/blogPosts';
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PortableText from '../PortableText.astro';
import ProjectImage from '../ProjectImage.astro';
import ArticleNav from './ArticleNav.astro';

interface Props {
  post: BlogPost;
  prev?: BlogPost;
  next?: BlogPost;
}

const {post, prev, next} = Astro.props;
const date = new Intl.DateTimeFormat('pl-PL', {day: 'numeric', month: 'long', year: 'numeric'}).format(new Date(post.publishedAt));
const sectionLabel = post.routeType === 'offer' ? 'Oferta' : 'Blog';
const pathPrefix = post.routeType === 'offer' ? 'oferta' : 'blog';
const socialImage = post.socialImage?.url ?? post.cover?.url;
const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': post.routeType === 'offer' ? 'WebPage' : 'BlogPosting',
  headline: post.seoTitle ?? post.title,
  description: post.seoDescription ?? post.excerpt,
  datePublished: post.publishedAt,
  author: {'@type': 'Person', name: post.author},
  ...(socialImage ? {image: socialImage} : {}),
  url: new URL(`/${pathPrefix}/${post.slug}`, Astro.site ?? 'https://tomaszmarek.com').toString(),
}).replace(/</g, '\\u003c');
---

<Base
  title={`${post.seoTitle ?? post.title} — Tomasz Marek Architekt`}
  description={post.seoDescription ?? post.excerpt}
  canonical={`/${pathPrefix}/${post.slug}`}
  socialImage={socialImage}
  contentType="article"
  author={post.author}
  publishedAt={post.publishedAt}
>
  <Header />
  <main>
    <article class="article-page">
      <script type="application/ld+json" set:html={articleJsonLd} />
      <header class="section section-spaced article-page__head">
        <div class="article-page__meta">
          <p class="tagline">{sectionLabel}{post.categories[0] ? ` · ${post.categories[0]}` : ''}</p>
          <p class="type-body-sm">{date} · {post.author} · {post.readingTime} min czytania</p>
        </div>
        <div class="article-page__intro">
          <h1 class="type-h1">{post.title}</h1>
          <p class="type-h3">{post.excerpt}</p>
        </div>
      </header>

      {post.cover && (
        <figure class="article-page__cover">
          <ProjectImage image={post.cover} alt={post.cover.alt ?? post.title} widths={[768, 1280, 1920, 2400]} sizes="100vw" format="avif" loading="eager" fetchpriority="high" />
        </figure>
      )}

      <section
        class:list={[
          'section',
          'section-spaced',
          'article-page__body',
          {'article-page__body--blog': post.routeType === 'blog'},
        ]}
      >
        <PortableText value={post.body} />
      </section>
    </article>
    {(prev || next) && <ArticleNav prev={prev} next={next} />}
  </main>
  <Footer />
</Base>

<style>
  .article-page__head {
    display: grid;
    grid-template-columns: minmax(15rem, 1fr) minmax(0, 2fr);
    gap: var(--space-16);
    align-items: start;
  }

  .article-page__meta {
    display: grid;
    gap: var(--space-4);
    color: var(--c-muted);
  }

  .article-page__intro { display: grid; gap: var(--space-8); }
  .article-page__intro h1 { max-width: 18ch; }
  .article-page__intro > p { max-width: 42ch; color: var(--c-muted); }

  .article-page__cover { overflow: hidden; background: var(--c-bg-alt); }
  .article-page__cover :global(img) { width: 100%; max-height: 82svh; object-fit: cover; }

  .article-page__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17.5rem, 2fr) minmax(0, 1fr);
  }

  .article-page__body :global(.portable-text) {
    grid-column: 2;
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .article-page__body--blog {
    grid-template-columns: minmax(0, 1fr) minmax(17.5rem, 46rem) minmax(0, 1fr);
  }

  .article-page__body--blog :global(.portable-text) {
    width: 100%;
    font-size: clamp(1.0625rem, 0.9rem + 0.35vw, 1.25rem);
    line-height: 1.78;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }

  .article-page__body--blog :global(.portable-text > p) {
    max-width: 68ch;
  }

  .article-page__body--blog :global(.portable-text > p:first-child) {
    font-family: var(--ff-heading);
    font-size: clamp(1.35rem, 1.05rem + 0.8vw, 1.8rem);
    font-weight: 450;
    line-height: 1.48;
    letter-spacing: var(--tracking-heading);
  }

  .article-page__body--blog :global(.portable-text > * + p),
  .article-page__body--blog :global(.portable-text > * + ul),
  .article-page__body--blog :global(.portable-text > * + ol) {
    margin-top: var(--space-6);
  }

  .article-page__body--blog :global(.portable-text > h2),
  .article-page__body--blog :global(.portable-text > h3),
  .article-page__body--blog :global(.portable-text > h4) {
    max-width: 24ch;
    font-family: var(--ff-heading);
    font-weight: 500;
    letter-spacing: var(--tracking-heading);
    text-wrap: balance;
  }

  .article-page__body--blog :global(.portable-text > h2) {
    margin-top: var(--space-24);
    font-size: clamp(2rem, 1.5rem + 1.5vw, 3rem);
    line-height: 1.12;
  }

  .article-page__body--blog :global(.portable-text > h3) {
    margin-top: var(--space-16);
    font-size: clamp(1.55rem, 1.3rem + 0.75vw, 2.15rem);
    line-height: 1.2;
  }

  .article-page__body--blog :global(.portable-text > h4) {
    margin-top: var(--space-12);
    font-size: clamp(1.25rem, 1.1rem + 0.4vw, 1.55rem);
    line-height: 1.3;
  }

  .article-page__body--blog :global(.portable-text > h2 + p),
  .article-page__body--blog :global(.portable-text > h3 + p),
  .article-page__body--blog :global(.portable-text > h4 + p) {
    margin-top: var(--space-4);
  }

  .article-page__body--blog :global(.portable-text > ul),
  .article-page__body--blog :global(.portable-text > ol) {
    display: grid;
    gap: var(--space-3);
    max-width: 62ch;
    padding-left: 1.4em;
  }

  .article-page__body--blog :global(.portable-text li) {
    padding-left: 0.35em;
  }

  .article-page__body--blog :global(.portable-text li::marker) {
    color: var(--c-muted);
  }

  .article-page__body--blog :global(.portable-text > blockquote) {
    max-width: 58ch;
    margin-top: var(--space-16);
    padding: var(--space-8);
    border: 0;
    background: var(--c-bg-alt);
    font-family: var(--ff-heading);
    font-size: clamp(1.3rem, 1.05rem + 0.65vw, 1.75rem);
    line-height: 1.45;
    letter-spacing: var(--tracking-heading);
  }

  .article-page__body--blog :global(.portable-text strong) {
    font-weight: 650;
  }

  .article-page__body--blog :global(.portable-text a) {
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, currentColor 55%, transparent);
  }

  .article-page__body--blog :global(.portable-text__image) {
    width: min(56rem, calc(100vw - (2 * var(--pad-x))));
    max-width: none;
    margin-block: var(--space-16);
    margin-left: 50%;
    transform: translateX(-50%);
  }

  @media (max-width: 768px) {
    .article-page__head,
    .article-page__body { grid-template-columns: 1fr; }
    .article-page__head { gap: var(--space-8); }
    .article-page__body :global(.portable-text) { grid-column: 1; }
    .article-page__body--blog :global(.portable-text > h2) { margin-top: var(--space-16); }
    .article-page__body--blog :global(.portable-text > h3),
    .article-page__body--blog :global(.portable-text > blockquote),
    .article-page__body--blog :global(.portable-text__image) { margin-top: var(--space-12); }
    .article-page__body--blog :global(.portable-text > blockquote) { padding: var(--space-6); }
  }
</style>
