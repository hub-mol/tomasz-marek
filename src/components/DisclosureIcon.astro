---
interface Props {
  class?: string;
}

const {class: className} = Astro.props;
---

<span class:list={['disclosure-icon', className]} aria-hidden="true">
  <svg viewBox="0 0 20 20">
    <path d="M2 10h16" />
    <path d="M10 2v16" />
  </svg>
</span>

<style>
  .disclosure-icon {
    align-self: center;
    justify-self: end;
    width: 1.25rem;
    height: 1.25rem;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5px;
    stroke-linecap: round;
    transition: transform 0.35s ease;
  }

  :global(details[open]) svg {
    transform: rotate(45deg);
  }
</style>
