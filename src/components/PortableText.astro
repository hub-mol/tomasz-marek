---
import {toHTML} from '@portabletext/to-html';
import type {PortableTextBlock} from '@portabletext/types';

interface Props {
  value?: PortableTextBlock[];
  class?: string;
}

const {value = [], class: className} = Astro.props;
const escapeAttribute = (input: unknown) => String(input ?? '')
  .replaceAll('&', '&amp;')
  .replaceAll('"', '&quot;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;');
const html = toHTML(value, {
  components: {
    types: {
      image: ({value: image}) => {
        const url = typeof image.url === 'string' ? image.url : '';
        if (!url) return '';
        const width = typeof image.width === 'number' ? image.width : undefined;
        const height = typeof image.height === 'number' ? image.height : undefined;
        return `<figure class="portable-text__image"><img src="${escapeAttribute(url)}"${width ? ` width="${width}"` : ''}${height ? ` height="${height}"` : ''} alt="${escapeAttribute(image.alt)}" loading="lazy" /></figure>`;
      },
    },
  },
});
---

{html && <div class:list={['portable-text', className]} set:html={html} />}

<style>
  .portable-text :global(p),
  .portable-text :global(ul),
  .portable-text :global(ol),
  .portable-text :global(blockquote) {
    max-width: 65ch;
  }

  .portable-text :global(* + p),
  .portable-text :global(* + ul),
  .portable-text :global(* + ol),
  .portable-text :global(* + blockquote),
  .portable-text :global(* + h2),
  .portable-text :global(* + h3) {
    margin-top: var(--space-4);
  }

  .portable-text :global(ul),
  .portable-text :global(ol) {
    padding-left: 1.25em;
  }

  .portable-text :global(ul) {
    list-style: disc;
  }

  .portable-text :global(ol) {
    list-style: decimal;
  }

  .portable-text :global(blockquote) {
    padding-left: var(--space-6);
    border-left: 1px solid currentColor;
  }

  .portable-text :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .portable-text :global(.portable-text__image) {
    margin-block: var(--space-12);
  }

  .portable-text :global(.portable-text__image img) {
    width: 100%;
    height: auto;
  }
</style>
