---
import type { ProjectInfo } from '../../data/portfolio';

interface Props {
  info: ProjectInfo;
}

const { info } = Astro.props;

const rows: [string, string][] = [
  ['Year', info.year],
  ['Client', info.client],
  ['Architects', info.architects],
  ['Location', info.location],
  ['Budget', info.budget],
  ['Surface', info.surface],
  ['Theme', info.theme],
  ['Status', info.status],
];
---

<dl class="info">
  {
    rows.map(([label, value]) => (
      <div class="info__row">
        <dt class="info__label">{label}:</dt>
        <dd class="info__value">{value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .info {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 40px;
    margin: 0;
  }

  .info__label {
    font-size: 15px;
    line-height: 22px;
    text-transform: uppercase;
    color: #707070;
  }

  .info__value {
    margin: 2px 0 0;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: -0.45px;
  }

  @media (max-width: 768px) {
    .info {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
