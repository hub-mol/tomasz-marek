---
import type { Project } from '../../data/portfolio';

interface Props {
  prev: Project;
  next: Project;
}

const { prev, next } = Astro.props;
---

<nav class="section pnav" aria-label="Inne realizacje">
  <a class="pnav__link pnav__link--prev" href={`/portfolio/${prev.slug}`}>
    <span class="pnav__dir type-label">Poprzednia</span>
    <span class="pnav__title type-heading-lg">{prev.title}</span>
  </a>
  <a class="pnav__link pnav__link--next" href={`/portfolio/${next.slug}`}>
    <span class="pnav__dir type-label">Następna</span>
    <span class="pnav__title type-heading-lg">{next.title}</span>
  </a>
</nav>

<style>
  .pnav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-8);
    padding-block: var(--space-16);
    border-top: 1px solid var(--c-line);
  }

  .pnav__link--next {
    text-align: right;
  }

  .pnav__dir {
    display: block;
    color: var(--c-muted);
  }

  .pnav__title {
    display: block;
    margin-top: var(--space-2);
    transition: color 0.3s ease;
  }

  .pnav__link:hover .pnav__title {
    color: var(--c-accent);
  }
</style>
