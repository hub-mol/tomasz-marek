---
import type { Project } from '../../data/portfolio';
import ProjectImage from '../ProjectImage.astro';
import ProjectFacts from './ProjectFacts.astro';
import ProjectContent from './ProjectContent.astro';
import ProjectHero from './ProjectHero.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const intro = project.description ?? 'Materiał roboczy. Opis idei, zakresu i najważniejszych decyzji projektowych zostanie uzupełniony.';
const hasContent = Boolean(project.content?.length);
---

<article class="project-mosaic">
  <ProjectHero project={project} />

  <section class="section section-spaced project-mosaic__facts">
    <ProjectFacts project={project} />
  </section>

  {hasContent ? (
    <ProjectContent blocks={project.content!} projectAlt={project.alt} />
  ) : (
    <>
      <section class="section section-spaced project-mosaic__statement">
        <p class="type-h2 text-pretty">{intro}</p>
      </section>

      <section class="section project-mosaic__gallery" aria-label={`Galeria projektu ${project.title}`}>
        {project.gallery.map((image, index) => (
          <figure class={`project-mosaic__image project-mosaic__image--${index % 5}`}>
            <ProjectImage
              image={image}
              alt={`${project.alt} — widok ${index + 2}`}
              widths={[480, 560, 840, 1280, 1920]}
              sizes="(max-width: 768px) 100vw, 60vw"
              format="avif"
              loading="lazy"
            />
          </figure>
        ))}
      </section>
    </>
  )}
</article>

<style>
  .project-mosaic__facts {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(17.5rem, 1fr);
    gap: var(--space-16);
  }

  .project-mosaic__facts :global(.project-facts) { grid-column: 2; }

  .project-mosaic__statement {
    display: flex;
    justify-content: flex-end;
  }

  .project-mosaic__statement p {
    max-width: 23ch;
  }

  .project-mosaic__gallery {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-8);
    padding-bottom: var(--sec-y);
  }

  .project-mosaic__image {
    background: var(--c-bg-alt);
  }

  .project-mosaic__image--0 {
    grid-column: 1 / span 7;
  }

  .project-mosaic__image--1 {
    grid-column: 8 / -1;
    align-self: end;
  }

  .project-mosaic__image--2 {
    grid-column: 1 / -1;
  }

  .project-mosaic__image--3 {
    grid-column: 1 / span 5;
  }

  .project-mosaic__image--4 {
    grid-column: 6 / -1;
  }

  .project-mosaic__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-mosaic__image--0 :global(img),
  .project-mosaic__image--1 :global(img),
  .project-mosaic__image--3 :global(img),
  .project-mosaic__image--4 :global(img) {
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 1024px) {
    .project-mosaic__facts {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .project-mosaic__facts :global(.project-facts) { grid-column: 1; }
  }

  @media (max-width: 768px) {
    .project-mosaic__statement {
      justify-content: flex-start;
    }

    .project-mosaic__gallery {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .project-mosaic__image--0,
    .project-mosaic__image--1,
    .project-mosaic__image--2,
    .project-mosaic__image--3,
    .project-mosaic__image--4 {
      grid-column: auto;
    }
  }
</style>
