---
// Dwukolumnowy blok obraz + tekst. `reverse` odwraca kolejność kolumn.
interface Props {
  img: string;
  title?: string;
  text?: string;
  reverse?: boolean;
  alt?: boolean;
}

const { img, title, text, reverse = false, alt = false } = Astro.props;
---

<section
  class:list={[
    'section',
    'mt',
    { 'mt--reverse': reverse, 'section--alt': alt },
  ]}
>
  <div class="mt__media">
    <img src={img} alt="" width="1024" height="627" loading="lazy" />
  </div>

  <div class="mt__body">
    {title && <h2 class="mt__title">{title}</h2>}
    {text && <p class="mt__text">{text}</p>}
    <slot />
  </div>
</section>

<style>
  .mt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
    padding-block: 110px;
  }

  .mt--reverse .mt__media {
    order: 2;
  }

  .mt__media img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .mt__body {
    max-width: 550px;
  }

  .mt__title {
    margin-bottom: 20px;
  }

  .mt__text {
    color: var(--c-muted);
  }

  @media (max-width: 1024px) {
    .mt {
      grid-template-columns: 1fr;
      gap: 35px;
      padding-block: 70px;
    }

    .mt--reverse .mt__media {
      order: 0;
    }

    .mt__body {
      max-width: none;
    }
  }
</style>
