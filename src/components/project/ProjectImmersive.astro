---
import { Image } from 'astro:assets';
import type { Project } from '../../data/portfolio';
import ProjectFacts from './ProjectFacts.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const placeholder = 'Materiał roboczy. Opis idei, zakresu i najważniejszych decyzji projektowych zostanie uzupełniony.';
---

<article class="project-immersive">
  <header class="project-immersive__hero">
    <Image
      src={project.img}
      alt={project.alt}
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
    />
    <div class="section project-immersive__title">
      <p class="tagline">{project.category}</p>
      <h1 class="type-h1">{project.title}</h1>
    </div>
  </header>

  <section class="section section-spaced project-immersive__intro split-golden">
    <ProjectFacts project={project} layout="grid" />
    <p class="type-h3 text-pretty">{placeholder}</p>
  </section>

  <section class="project-immersive__gallery" aria-label={`Galeria projektu ${project.title}`}>
    {
      project.gallery.map((image, index) => (
        <figure class:list={['project-immersive__image', { 'project-immersive__image--inset': index % 3 === 1 }] }>
          <Image
            src={image}
            alt={`${project.alt} — widok ${index + 2}`}
            widths={[768, 1280, 1920, 2400]}
            sizes={index % 3 === 1 ? '(max-width: 768px) 100vw, 68vw' : '100vw'}
            format="avif"
            loading="lazy"
          />
        </figure>
      ))
    }
  </section>
</article>

<style>
  .project-immersive__hero {
    position: relative;
    height: 66svh;
    max-height: 66svh;
    overflow: hidden;
    background: #171816;
    color: #fff;
  }

  .project-immersive__hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.58), transparent 58%);
  }

  .project-immersive__hero > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-immersive__title {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding-bottom: var(--space-16);
  }

  .project-immersive__title .tagline {
    color: rgba(255, 255, 255, 0.7);
  }

  .project-immersive__title h1 {
    max-width: 16ch;
  }

  .project-immersive__intro {
    align-items: start;
  }

  .project-immersive__intro > p {
    max-width: 26ch;
    justify-self: end;
  }

  .project-immersive__gallery {
    display: grid;
    gap: var(--space-16);
    padding-bottom: var(--sec-y);
  }

  .project-immersive__image {
    background: var(--c-bg-alt);
  }

  .project-immersive__image--inset {
    width: min(68vw, 76rem);
    margin-inline: auto;
  }

  .project-immersive__image :global(img) {
    width: 100%;
    max-height: 92svh;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .project-immersive__title {
      padding-bottom: var(--space-8);
    }

    .project-immersive__intro > p {
      justify-self: start;
    }

    .project-immersive__gallery {
      gap: var(--space-4);
    }

    .project-immersive__image--inset {
      width: 100%;
    }
  }
</style>
