---
import type { Project } from '../../data/portfolio';
import ProjectImage from '../ProjectImage.astro';
import ProjectFacts from './ProjectFacts.astro';
import ProjectContent from './ProjectContent.astro';
import ProjectHero from './ProjectHero.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const intro = project.description ?? 'Materiał roboczy. Opis idei, zakresu i najważniejszych decyzji projektowych zostanie uzupełniony.';
const hasContent = Boolean(project.content?.length);
---

<article class="project-immersive">
  <ProjectHero project={project} />

  {hasContent ? (
    <>
      <section class="section section-spaced project-immersive__intro">
        <ProjectFacts project={project} layout="grid" />
      </section>
      <ProjectContent blocks={project.content!} projectAlt={project.alt} />
    </>
  ) : (
    <>
      <section class="section section-spaced project-immersive__intro split-golden">
        <ProjectFacts project={project} layout="grid" />
        <p class="type-h3 text-pretty">{intro}</p>
      </section>

      <section class="project-immersive__gallery" aria-label={`Galeria projektu ${project.title}`}>
        {project.gallery.map((image, index) => (
          <figure class:list={['project-immersive__image', { 'project-immersive__image--inset': index % 3 === 1 }] }>
            <ProjectImage
              image={image}
              alt={`${project.alt} — widok ${index + 2}`}
              widths={[480, 768, 1280, 1920, 2400]}
              sizes={index % 3 === 1 ? '(max-width: 768px) 100vw, 68vw' : '100vw'}
              format="avif"
              loading="lazy"
            />
          </figure>
        ))}
      </section>
    </>
  )}
</article>

<style>
  .project-immersive__intro {
    align-items: start;
  }

  .project-immersive__intro > p {
    max-width: 26ch;
    justify-self: end;
  }

  .project-immersive__gallery {
    display: grid;
    gap: var(--space-16);
    padding-bottom: var(--sec-y);
  }

  .project-immersive__image {
    background: var(--c-bg-alt);
  }

  .project-immersive__image--inset {
    width: min(68vw, 76rem);
    margin-inline: auto;
  }

  .project-immersive__image :global(img) {
    width: 100%;
    max-height: 92svh;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .project-immersive__intro > p {
      justify-self: start;
    }

    .project-immersive__gallery {
      gap: var(--space-4);
    }

    .project-immersive__image--inset {
      width: 100%;
    }
  }
</style>
