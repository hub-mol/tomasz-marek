---
// Siatka zdjęć. Liczba kolumn wynika z liczby zdjęć — 4 układają się 2×2.
interface Props {
  images: string[];
}

const { images } = Astro.props;
const cols = images.length % 2 === 0 ? 2 : 3;
---

<section class="section gallery" style={`--cols:${cols}`}>
  <ul class="gallery__grid">
    {
      images.map((img) => (
        <li>
          <img src={img} alt="" width="800" height="600" loading="lazy" />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .gallery {
    padding-block: var(--space-16);
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: var(--space-8);
  }

  .gallery__grid img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .gallery__grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
