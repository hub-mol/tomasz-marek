---
import {nextSteps as defaultSteps} from '../../data/home';

export interface Step {
  title: string;
  text: string;
}

interface Props {
  steps?: Step[];
}

const { steps = defaultSteps } = Astro.props;
---

<ul class="next-steps__list">
  {steps.map((step, i) => (
    <li class="next-steps__step">
      <span class="next-steps__num type-body-sm">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="next-steps__title type-h4">{step.title}</h3>
      <p class="next-steps__text">{step.text}</p>
    </li>
  ))}
</ul>

<style>
  /* Linia nad siatką i pionowe kreski między krokami — jak filary w „Podejściu”.
     Sekcja procesu ma ciemne tło, więc kolory idą z palety na ciemne. */
  .next-steps__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--c-line-dark);
  }

  .next-steps__step {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    border-right: 1px solid var(--c-line-dark);
  }

  .next-steps__step:first-child {
    padding-left: 0;
  }

  .next-steps__step:last-child {
    border-right: 0;
  }

  /* Te same kolory co numery i opisy w akordeonie obok. */
  .next-steps__num {
    color: var(--c-accent);
    margin-bottom: var(--space-4);
  }

  .next-steps__title {
    margin: 0 0 var(--space-4) 0;
  }

  .next-steps__text {
    margin: 0;
    color: var(--c-on-dark-muted);
  }

  @media (max-width: 1024px) {
    .next-steps__list {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Przy dwóch kolumnach kreska pionowa zostaje tylko w pierwszej,
       a drugi wiersz dostaje własną linię u góry. */
    .next-steps__step:nth-child(2n) {
      border-right: 0;
    }

    .next-steps__step:nth-child(n + 3) {
      border-top: 1px solid var(--c-line-dark);
    }

    .next-steps__step:nth-child(2n + 1) {
      padding-left: 0;
    }
  }

  @media (max-width: 768px) {
    .next-steps__list {
      grid-template-columns: 1fr;
    }

    .next-steps__step,
    .next-steps__step:nth-child(n + 3) {
      padding: var(--space-8) 0;
      border-right: 0;
      border-top: 0;
      border-bottom: 1px solid var(--c-line-dark);
    }

    .next-steps__step:last-child {
      border-bottom: 0;
    }
  }
</style>
