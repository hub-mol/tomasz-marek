---
import type { AccordionItem } from './Accordion.astro';
import { plNoBreak } from '../../utils/typography';
import DisclosureIcon from '../DisclosureIcon.astro';

interface Props {
  architecture: AccordionItem[];
  interiors: AccordionItem[];
}

const { architecture, interiors } = Astro.props;

const groups = [
  { title: 'Proces architektura', items: architecture },
  { title: 'Proces wnętrza', items: interiors },
];
---

<section class="section section-spaced process" id="proces">
  <header class="process__head section-head split-golden">
    <h2>Rozmowa&ensp;⁄&ensp;Realizacja</h2>
  </header>

  <div class="process__groups">
    {
      groups.map((group) => (
        <article class="process__group">
          <h3 class="process__group-title tagline">{group.title}</h3>

          <div class="process__list">
            {group.items.map((item, i) => (
              <details class="process__item" name={`process-${group.title}`}>
                <summary class="process__summary">
                  <span class="process__num type-body-sm">{String(i + 1).padStart(2, '0')}</span>
                  <span class="process__label type-h3">{plNoBreak(item.title)}</span>
                  <DisclosureIcon />
                </summary>
                <div class="process__body">
                  <p>{plNoBreak(item.body)}</p>
                </div>
              </details>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .process {
    background: #171816;
    color: #fff;
  }

  .process .tagline {
    color: #a7a7a7;
  }

  .process__head h2 {
    grid-column: 2;
    justify-self: end;
  }

  .process__groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(var(--space-12), 6vw, var(--space-24));
  }

  .process__group-title {
    margin-bottom: var(--space-6);
  }

  .process__list {
    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }

  .process__item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }

  .process__summary {
    display: grid;
    grid-template-columns: 2.125rem 1fr 1.25rem;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-6);
    list-style: none;
    cursor: pointer;
  }

  .process__summary::-webkit-details-marker {
    display: none;
  }

  .process__num {
    color: #929292;
  }

  .process__label {
    transition: color 0.25s ease;
  }

  .process__summary:hover .process__label {
    color: var(--c-accent);
  }

  .process__body {
    max-width: 36.25rem;
    padding: 0 var(--space-8) var(--space-6) var(--space-12);
    color: #bcbcbc;
  }

  @media (max-width: 1024px) {
    .process__head h2 {
      grid-column: auto;
    }
  }

  @media (max-width: 768px) {
    .process__groups {
      grid-template-columns: 1fr;
      gap: var(--space-16);
    }

    .process__head {
      margin-bottom: var(--space-12);
    }

    .process__head h2 {
      align-self: start;
      justify-self: start;
      text-align: left;
    }

    .process__body {
      padding-left: var(--space-12);
      padding-right: 0;
    }
  }
</style>
