---
// Sekcja A: nagłówek, oś procesu (ProcessTimeline) i pod nią kroki współpracy
// (NextSteps), na mobile przewijana poziomo. Sekcja B to ProcessOverview obok.
import NextSteps, {type Step} from './NextSteps.astro';
import ProcessTimeline from './ProcessTimeline.astro';

interface Props {
  heading?: string;
  steps?: Step[];
}

const { heading = 'Jak wygląda współpraca?', steps } = Astro.props;
---

<section class="section section-spaced wspolpraca">
  <header class="wspolpraca__head">
    <h2 class="type-h3">{heading}</h2>
  </header>

  <div class="wspolpraca__diagram">
    <ProcessTimeline dark />
  </div>

  <div class="wspolpraca__next-steps">
    <NextSteps steps={steps} />
  </div>
</section>

<style>
  .wspolpraca {
    background: var(--c-bg-dark);
    color: var(--c-on-dark);
  }

  .wspolpraca__head h2 {
    max-width: 32ch;
  }

  .wspolpraca__diagram {
    margin-top: var(--space-16);
    margin-inline: calc(var(--gutter) * -1);
  }

  .wspolpraca__next-steps {
    margin-top: var(--space-24);
  }
</style>
