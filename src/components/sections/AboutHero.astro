---
import { plNoBreak } from '../../utils/typography';
import ProjectImage from '../ProjectImage.astro';
import type {ProjectImage as ProjectImageType} from '../../data/portfolio';

// Edytorialny blok o pracowni: tekstowa kolumna i dominujące zdjęcie.
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  text?: string;
  paragraphs?: string[];
  leadFirst?: boolean;
  img?: string | ProjectImageType;
  alt?: string;
}

const {
  id,
  eyebrow = 'O mnie',
  title = 'ArhiconStudio',
  text = 'We reach beyond established trends and apply new creative solutions. Right place for achieving top results.',
  paragraphs,
  leadFirst = true,
  img = '/img/tm-5.jpg',
  alt = '',
} = Astro.props;

const copy = paragraphs ?? [text];
---

<section class="about-hero" id={id}>
  <div class="section about-hero__inner split-golden">
    <div class="about-hero__col about-hero__col--text">
      <div>
        {eyebrow && <p class="tagline">{eyebrow}</p>}
        <h2 class="about-hero__title type-h2">{plNoBreak(title)}</h2>
      </div>

      <div class="about-hero__intro">
        {copy.map((paragraph, i) => (
          <p class:list={['about-hero__paragraph', 'text-pretty', { 'about-hero__lead': leadFirst && i === 0, 'type-h3': leadFirst && i === 0 }]}>
            {plNoBreak(paragraph)}
          </p>
        ))}
      </div>
    </div>

    <div class="about-hero__col about-hero__col--media">
      {typeof img === 'string' ? (
        <img src={img} alt={alt} width="1200" height="900" loading="lazy" />
      ) : (
        <ProjectImage image={img} alt={alt} widths={[640, 960, 1440]} sizes="(max-width: 1024px) 100vw, 40vw" format="avif" loading="lazy" />
      )}
    </div>
  </div>
</section>

<style>
  .about-hero {
    min-height: 45rem;
    background: #262724;
    color: #fff;
    overflow: hidden;
  }

  .about-hero__inner {
    min-height: inherit;
    grid-template-columns: minmax(0, 1.6fr) minmax(17.5rem, 1fr);
  }

  .about-hero__col--text {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-block: var(--sec-y);
  }

  .about-hero .tagline {
    color: rgba(255, 255, 255, 0.6);
  }

  .about-hero__title {
    margin: 0;
    white-space: pre-line;
  }

  .about-hero__intro {
    margin-top: var(--space-32);
  }

  .about-hero__lead {
    max-width: 35rem;
  }

  .about-hero__paragraph {
    max-width: 60ch;
    color: rgba(255, 255, 255, 0.7);
  }

  .about-hero__paragraph + .about-hero__paragraph {
    margin-top: var(--space-4);
  }

  .about-hero__paragraph.about-hero__lead {
    color: #fff;
  }

  .about-hero__col--media {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    width: calc(100% + var(--gutter));
    min-height: inherit;
    margin-right: calc(-1 * var(--gutter));
    overflow: hidden;
  }

  .about-hero__col--media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-height: 100%;
    max-width: none;
    object-fit: cover;
  }

  @media (max-width: 1024px) {
    .about-hero {
      min-height: 0;
    }

    .about-hero__inner {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .about-hero__col--text {
      grid-column: 1;
      grid-row: 1;
    }

    .about-hero__col--media {
      grid-column: 1;
      grid-row: 2;
      width: calc(100% + 2 * var(--gutter));
      min-height: 26.25rem;
      margin-inline: calc(-1 * var(--gutter));
    }
  }

  @media (max-width: 768px) {
    .about-hero__inner {
      --split-gap-tablet: var(--space-12);
    }

    .about-hero__intro {
      margin-top: var(--space-16);
    }

    .about-hero__col--media {
      min-height: 20rem;
    }
  }
</style>
