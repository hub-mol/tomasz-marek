---
import { plNoBreak } from '../../utils/typography';

// Edytorialny blok o pracowni: tekstowa kolumna i dominujące zdjęcie.
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  text?: string;
  paragraphs?: string[];
  leadFirst?: boolean;
  img?: string;
}

const {
  id,
  eyebrow = 'O mnie',
  title = 'ArhiconStudio',
  text = 'We reach beyond established trends and apply new creative solutions. Right place for achieving top results.',
  paragraphs,
  leadFirst = true,
  img = '/img/tm-5.jpg',
} = Astro.props;

const copy = paragraphs ?? [text];
---

<section class="about-hero" id={id}>
  <div class="section about-hero__inner split-golden">
    <div class="about-hero__col about-hero__col--text">
      <div>
        {eyebrow && <p class="about-hero__eyebrow eyebrow">{eyebrow}</p>}
        <h2 class="about-hero__title type-lead">{plNoBreak(title)}</h2>
      </div>

      <div class="about-hero__intro">
        {copy.map((paragraph, i) => (
          <p class:list={['about-hero__paragraph', { 'about-hero__lead': leadFirst && i === 0 }]}>
            {plNoBreak(paragraph)}
          </p>
        ))}
      </div>
    </div>

    <div class="about-hero__col about-hero__col--media">
      <img
        src={img}
        alt=""
        width="1200"
        height="900"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .about-hero {
    min-height: 720px;
    background: #262724;
    color: #fff;
    overflow: hidden;
  }

  .about-hero__inner {
    min-height: inherit;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr);
  }

  .about-hero__col--text {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: 70px 75px;
  }

  .about-hero__eyebrow {
    margin-bottom: 14px;
    color: rgba(255, 255, 255, 0.6);
  }

  .about-hero__title {
    margin: 0;
    font-size: clamp(2.5rem, 3.8vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    white-space: pre-line;
  }

  .about-hero__intro {
    margin-top: auto;
    padding-top: 60px;
  }

  .about-hero__lead {
    max-width: 560px;
    font-size: clamp(1.5rem, 2.2vw, 2.2rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .about-hero__paragraph {
    max-width: 60ch;
    color: rgba(255, 255, 255, 0.7);
    text-wrap: balance;
  }

  .about-hero__paragraph + .about-hero__paragraph {
    margin-top: 16px;
  }

  .about-hero__paragraph.about-hero__lead {
    color: #fff;
  }

  .about-hero__col--media {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    width: calc(100% + var(--gutter));
    min-height: inherit;
    margin-right: calc(-1 * var(--gutter));
    overflow: hidden;
  }

  .about-hero__col--media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  @media (max-width: 1024px) {
    .about-hero {
      min-height: 0;
    }

    .about-hero__inner {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .about-hero__col--text {
      grid-column: 1;
      grid-row: 1;
      padding-block: 55px 60px;
    }

    .about-hero__col--media {
      grid-column: 1;
      grid-row: 2;
      width: calc(100% + 2 * var(--gutter));
      min-height: 420px;
      margin-inline: calc(-1 * var(--gutter));
    }
  }

  @media (max-width: 768px) {
    .about-hero__inner {
      --split-gap-tablet: 48px;
    }

    .about-hero__intro {
      padding-top: 75px;
    }

    .about-hero__col--media {
      min-height: 320px;
    }
  }
</style>
