---
import { plNoBreak } from '../../utils/typography';
import type {PortableTextBlock} from '@portabletext/types';
import ArrowLink from '../ArrowLink.astro';
import PortableText from '../PortableText.astro';
import ProjectImage from '../ProjectImage.astro';
import type {ProjectImage as ProjectImageType} from '../../data/portfolio';
import {paragraphsToPortableText} from '../../utils/portableText';
import aboutFallback from '../../assets/images/hero-2.png';

// Edytorialny blok o pracowni: tekstowa kolumna i dominujące zdjęcie.
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  titleClass?: 'type-h2' | 'type-h3';
  text?: string;
  body?: PortableTextBlock[];
  leadFirst?: boolean;
  img?: ProjectImageType;
  alt?: string;
}

const {
  id,
  eyebrow = 'O mnie',
  title = 'ArhiconStudio',
  titleClass = 'type-h2',
  text = 'We reach beyond established trends and apply new creative solutions. Right place for achieving top results.',
  body,
  leadFirst = true,
  img = aboutFallback,
  alt = '',
} = Astro.props;

const copy = body ?? paragraphsToPortableText([text], 'about');
---

<section class="about-hero" id={id}>
  <div class="section about-hero__inner split-golden">
    <div class="about-hero__col about-hero__col--text">
      <div>
        {eyebrow && <p class="tagline">{eyebrow}</p>}
        <h2 class:list={['about-hero__title', titleClass]}>{plNoBreak(title)}</h2>
      </div>

      <div class:list={['about-hero__intro', {'about-hero__intro--lead-first': leadFirst}]}>
        <PortableText value={copy} />
        <ArrowLink href="/#kontakt">Umów konsultację ze&nbsp;mną</ArrowLink>
      </div>
    </div>

    <div class="about-hero__col about-hero__col--media">
      <ProjectImage image={img} alt={alt} widths={[480, 640, 960, 1440]} sizes="(max-width: 1024px) 100vw, 40vw" format="avif" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .about-hero {
    min-height: 45rem;
    background: var(--c-bg-dark-soft);
    color: var(--c-on-dark);
    overflow: hidden;
  }

  .about-hero__inner {
    min-height: inherit;
    grid-template-columns: minmax(0, 1.6fr) minmax(17.5rem, 1fr);
  }

  .about-hero__col--text {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: var(--sec-y);
  }

  .about-hero .tagline {
    color: color-mix(in srgb, var(--c-on-dark) 60%, transparent);
  }

  .about-hero__title {
    margin: 0;
    white-space: pre-line;
  }

  .about-hero__intro {
    margin-top: var(--space-32);
  }

  .about-hero__intro :global(.portable-text p) {
    max-width: 60ch;
    color: color-mix(in srgb, var(--c-on-dark) 70%, transparent);
  }

  .about-hero__intro :global(.portable-text > p + p) {
    margin-top: var(--space-4);
  }

  .about-hero__intro--lead-first :global(.portable-text > p:first-child) {
    max-width: 35rem;
    font-family: var(--ff-heading);
    font-size: var(--h3);
    line-height: 1.08;
    letter-spacing: var(--tracking-heading);
    color: var(--c-on-dark);
  }

  .about-hero__intro :global(.arrow-link) {
    margin-top: var(--space-8);
  }

  .about-hero__col--media {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    width: calc(100% + var(--gutter));
    min-height: inherit;
    margin-right: calc(-1 * var(--gutter));
    overflow: hidden;
  }

  .about-hero__col--media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 10%;
  }

  @media (max-width: 1024px) {
    .about-hero {
      min-height: 0;
    }

    .about-hero__inner {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .about-hero__col--text {
      grid-column: 1;
      grid-row: 1;
    }

    .about-hero__col--media {
      grid-column: 1;
      grid-row: 2;
      width: calc(100% + 2 * var(--gutter));
      min-height: 26.25rem;
      margin-inline: calc(-1 * var(--gutter));
    }
  }

  @media (max-width: 768px) {
    .about-hero__inner {
      --split-gap-tablet: var(--space-12);
    }

    .about-hero__intro {
      margin-top: var(--space-16);
    }

    .about-hero__col--media {
      min-height: 0;
      aspect-ratio: 1;
    }
  }
</style>
