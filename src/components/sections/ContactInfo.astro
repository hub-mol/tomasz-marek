---
import ArrowLink from '../ArrowLink.astro';
import { plNoBreak } from '../../utils/typography';
import {getSiteSettings} from '../../data/site';

const settings = await getSiteSettings();
const {email, phoneLabel, phoneHref, bookingHref, bookingLabel} = settings;
---

<section class="section section-spaced contact" id="kontakt">
  <div class="contact__inner split-golden">
    <h2 class="contact__title type-h3">Porozmawiajmy o Twoim projekcie</h2>

    <p class="text-pretty">{plNoBreak('Planujesz budowę, przebudowę albo nowe wnętrze? Opowiedz mi o swojej inwestycji. Podczas pierwszej rozmowy sprawdzimy, w jakim zakresie mogę Ci pomóc.')}</p>

    <div class="contact__details">
      <a class="link-btn" href={`mailto:${email}`}>{email}</a>
      <a class="link-btn" href={`tel:${phoneHref}`}>{phoneLabel}</a>
    </div>

    <ArrowLink href={bookingHref} typeClass="type-h3">
      {bookingLabel}
    </ArrowLink>
  </div>
</section>

<style>
  .contact {
    background: var(--c-bg-dark);
    color: var(--c-on-dark);
  }

  .contact__inner {
    --split-gap: clamp(var(--space-16), 8vw, var(--space-32));
    row-gap: var(--space-6);
    align-items: start;
  }

  .contact__title {
    margin-bottom: var(--space-6);
  }

  .contact__inner > p {
    max-width: 37.5rem;
    color: var(--c-on-dark-muted);
  }

  /* linki w zdaniu: podkreślenie, bez wersalików z .link-btn */
  .contact__inner p a:not(.link-btn) {
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }

  .contact__details {
    grid-column: 2;
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    margin-block: var(--space-2);
  }

  .contact__inner > :global(.arrow-link) {
    grid-column: 2;
  }

  @media (max-width: 768px) {
    .contact__inner {
      --split-gap-tablet: var(--space-6);
    }

    .contact__details,
    .contact__inner > :global(.arrow-link) {
      grid-column: auto;
    }
  }
</style>
