---
import ArrowLink from '../ArrowLink.astro';

const email = 'biuro@tomaszmarek.com';
const phoneLabel = '+48 696 995 899';
const phoneHref = '+48696995899';
---

<section class="section contact" id="kontakt">
  <div class="contact__inner split-golden">
    <h2 class="contact__title">Porozmawiajmy o Twoim projekcie</h2>

    <p>
      Planujesz budowę, przebudowę albo nowe wnętrze? Opowiedz mi o swojej
      inwestycji. Podczas pierwszej rozmowy sprawdzimy, w jakim zakresie mogę Ci pomóc.
    </p>

    <div class="contact__details">
      <a class="link-btn" href={`mailto:${email}`}>{email}</a>
      <a class="link-btn" href={`tel:${phoneHref}`}>{phoneLabel}</a>
    </div>

    <ArrowLink href={`mailto:${email}?subject=Konsultacja architektoniczna`}>
      Umów konsultację
    </ArrowLink>
  </div>
</section>

<style>
  .contact {
    padding-block: 125px;
    background: #171816;
    color: #fff;
  }

  .contact__inner {
    --split-gap: clamp(60px, 8vw, 150px);
    row-gap: 24px;
    align-items: start;
  }

  .contact__title {
    margin-bottom: 22px;
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    font-weight: 400;
  }

  .contact__inner > p {
    max-width: 600px;
    color: #bcbcbc;
  }

  /* linki w zdaniu: podkreślenie, bez wersalików z .link-btn */
  .contact__inner p a:not(.link-btn) {
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }

  .contact__inner p a:not(.link-btn):hover {
    color: var(--c-accent);
  }

  .contact__details {
    grid-column: 2;
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-block: 10px 8px;
  }

  .contact__inner > :global(.arrow-link) {
    grid-column: 2;
  }

  @media (max-width: 1024px) {
    .contact {
      padding-block: 90px;
    }
  }

  @media (max-width: 768px) {
    .contact__inner {
      --split-gap-tablet: 24px;
    }

    .contact__details,
    .contact__inner > :global(.arrow-link) {
      grid-column: auto;
    }
  }
</style>
