---
import ArrowLink from '../ArrowLink.astro';
import { plNoBreak } from '../../utils/typography';

const email = 'biuro@tomaszmarek.com';
const phoneLabel = '+48 696 995 899';
const phoneHref = '+48696995899';
---

<section class="section contact" id="kontakt">
  <div class="contact__inner split-golden">
    <h2 class="contact__title">Porozmawiajmy o Twoim projekcie</h2>

    <p class="text-pretty">{plNoBreak('Planujesz budowę, przebudowę albo nowe wnętrze? Opowiedz mi o swojej inwestycji. Podczas pierwszej rozmowy sprawdzimy, w jakim zakresie mogę Ci pomóc.')}</p>

    <div class="contact__details">
      <a class="link-btn" href={`mailto:${email}`}>{email}</a>
      <a class="link-btn" href={`tel:${phoneHref}`}>{phoneLabel}</a>
    </div>

    <ArrowLink href={`mailto:${email}?subject=Konsultacja architektoniczna`}>
      Umów konsultację
    </ArrowLink>
  </div>
</section>

<style>
  .contact {
    padding-block: 7.8125rem;
    background: #171816;
    color: #fff;
  }

  .contact__inner {
    --split-gap: clamp(var(--space-16), 8vw, var(--space-32));
    row-gap: var(--space-6);
    align-items: start;
  }

  .contact__title {
    margin-bottom: var(--space-6);
    font-size: var(--h3);
    line-height: 1.125;
    letter-spacing: var(--tracking-heading);
    font-weight: 400;
  }

  .contact__inner > p {
    max-width: 37.5rem;
    color: #bcbcbc;
  }

  /* linki w zdaniu: podkreślenie, bez wersalików z .link-btn */
  .contact__inner p a:not(.link-btn) {
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }

  .contact__inner p a:not(.link-btn):hover {
    color: var(--c-accent);
  }

  .contact__details {
    grid-column: 2;
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    margin-block: var(--space-2);
  }

  .contact__inner > :global(.arrow-link) {
    grid-column: 2;
  }

  @media (max-width: 1024px) {
    .contact {
      padding-block: 5.625rem;
    }
  }

  @media (max-width: 768px) {
    .contact__inner {
      --split-gap-tablet: var(--space-6);
    }

    .contact__details,
    .contact__inner > :global(.arrow-link) {
      grid-column: auto;
    }
  }
</style>
