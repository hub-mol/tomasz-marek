---
import { plNoBreak } from '../../utils/typography';
import DisclosureIcon from '../DisclosureIcon.astro';

// Jeden komponent w dwóch trybach:
//   interactive — rozwijany <details>, do FAQ
//   static      — wszystkie panele otwarte, bez strzałki i bez interakcji (proces)
export interface AccordionItem {
  title: string;
  body: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  items: AccordionItem[];
  variant?: 'interactive' | 'static';
  numbered?: boolean;
  alt?: boolean;
}

const {
  id,
  eyebrow,
  title,
  items,
  variant = 'interactive',
  numbered = false,
  alt = false,
} = Astro.props;

const isStatic = variant === 'static';
---

<section class:list={['section', 'section-spaced', 'accordion-sec', 'split-golden', { 'section--alt': alt }]} id={id}>
  <div class="accordion-sec__col">
    {eyebrow && <p class="tagline">{plNoBreak(eyebrow)}</p>}
    <h2 class="accordion-sec__title">{plNoBreak(title)}</h2>
  </div>

  <div class="accordion-sec__col accordion">
    {
      items.map((item, i) => {
        const num = numbered ? String(i + 1).padStart(2, '0') : null;

        return isStatic ? (
          <div class="accordion__item">
            <div class="accordion__head">
              {num && <span class="accordion__num">{num}</span>}
              <span class="accordion__label">{plNoBreak(item.title)}</span>
            </div>
            <div class="accordion__body">
              <p>{plNoBreak(item.body)}</p>
            </div>
          </div>
        ) : (
          <details class="accordion__item" name={id ?? 'accordion'}>
            <summary class="accordion__head">
              {num && <span class="accordion__num">{num}</span>}
              <span class="accordion__label">{plNoBreak(item.title)}</span>
              <DisclosureIcon />
            </summary>
            <div class="accordion__body">
              <p>{plNoBreak(item.body)}</p>
            </div>
          </details>
        );
      })
    }
  </div>
</section>

<style>
  /* dwie kolumny — tytuł po lewej, pozycje po prawej */
  .accordion-sec__title {
    max-width: 38.3125rem;
  }

  .accordion__item {
    border-bottom: 1px solid var(--c-line);
  }

  .accordion__head {
    display: flex;
    /* numer siada na linii bazowej OSTATNIEJ linii tytułu — przy zawinięciu
       nie zawisa w połowie wysokości. Pierwsza deklaracja to zapas
       dla silników bez obsługi `last`. */
    align-items: baseline;
    align-items: last baseline;
    gap: var(--space-4);
    padding: var(--space-6) 0;
    font-size: var(--text-lg);
    line-height: var(--leading-xl);
    letter-spacing: var(--tracking-tight);
    list-style: none;
  }

  details.accordion__item .accordion__head {
    cursor: pointer;
  }

  .accordion__head::-webkit-details-marker {
    display: none;
  }

  .accordion__num {
    min-width: 2.125rem;
    font-family: var(--ff-body);
    font-size: var(--text-md);
    letter-spacing: normal;
    color: var(--c-gray);
  }

  .accordion__label {
    flex: 1;
    font-family: var(--ff-heading);
  }

  details.accordion__item .accordion__head:hover .accordion__label {
    color: var(--c-accent);
  }

  .accordion__body {
    padding: 0 var(--space-6) var(--space-6) var(--space-12);
    color: var(--c-muted);
  }

  .accordion__body p {
    max-width: 62ch;
    text-wrap: balance;
  }

  @media (max-width: 1024px) {
    .accordion-sec {
      --split-gap-tablet: var(--space-8);
    }
  }

  @media (max-width: 768px) {
    .accordion__body {
      padding-inline: 0;
    }
  }
</style>
