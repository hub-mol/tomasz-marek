---
// Lista kwalifikacji. Rzeczy formalne podane sucho, bez marketingu —
// klient ma je odczytać jako fakty, nie jako obietnice.
interface Pozycja {
  label: string;
  detail?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  items?: Pozycja[];
}

const {
  eyebrow = 'Kwalifikacje',
  title = 'Potwierdzenie moich umiejętności',
  items = [
    { label: 'Uprawnienia budowlane', detail: 'projektowanie bez ograniczeń w specjalności architektonicznej' },
    { label: 'Izba Architektów RP', detail: 'prawo do samodzielnego podpisywania dokumentacji' },
    { label: 'Politechnika Gdańska', detail: 'Wydział Architektury i Urbanistyki' },
    { label: 'Politecnico di Milano', detail: 'Faculty of Architecture and Urban Design' },
    { label: 'BIM Modeler — Revit', detail: 'kurs ukończony' },
    { label: 'Program PFR dla startupów', detail: 'kurs ukończony' },
  ],
} = Astro.props;
---

<section class="section creds split-golden">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="creds__title">{title}</h2>
  </div>

  <dl class="creds__list">
    {
      items.map((it) => (
        <div class="creds__row">
          <dt class="creds__label">{it.label}</dt>
          {it.detail && <dd class="creds__detail">{it.detail}</dd>}
        </div>
      ))
    }
  </dl>
</section>

<style>
  .creds {
    padding-block: var(--sec-y);
  }

  .creds__title {
    margin-top: 12px;
  }

  .creds__list {
    margin: 0;
  }

  .creds__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 30px;
    padding-block: 20px;
    border-bottom: 1px solid var(--c-line);
  }

  .creds__row:first-child {
    border-top: 1px solid var(--c-line);
  }

  .creds__label {
    font-family: var(--ff-heading);
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .creds__detail {
    margin: 0;
    color: var(--c-muted);
  }

  @media (max-width: 768px) {
    .creds__row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
