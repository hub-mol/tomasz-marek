---
import { getProjects } from '../../data/projects';
import ProjectImage from '../ProjectImage.astro';

// Odpowiednik `varied_rows_portfolio_list` z dema: wiersze po dwie realizacje,
// w których szerokości zamieniają się miejscami (60/40, potem 40/60).
interface Props {
  title?: string;
  eyebrow?: string;
  limit?: number;
  showHeader?: boolean;
}

const {
  title = 'Realizacje',
  eyebrow = 'Wybrane projekty',
  limit = 6,
  showHeader = true,
} = Astro.props;

const projects = await getProjects();
const items = projects.slice(0, limit);
const pary = Array.from({ length: Math.ceil(items.length / 2) }, (_, i) =>
  items.slice(i * 2, i * 2 + 2)
);
---

<section class="section section-spaced rows" id="realizacje">
  {
    showHeader && (
      <header class="rows__head">
        <p class="tagline">{eyebrow}</p>
        <h2>{title}</h2>
      </header>
    )
  }

  {
    pary.map((para, i) => (
      <div class:list={['rows__row', { 'rows__row--swap': i % 2 === 1 }]}>
        {para.map((p) => (
          <a class="rows__item" href={`/projekty/${p.slug}`}>
            <span class="rows__media">
              <ProjectImage
                image={p.img}
                alt={p.alt}
                widths={[640, 960, 1440]}
                sizes="(max-width: 768px) 100vw, 60vw"
                format="avif"
                loading="lazy"
              />
            </span>
            <span class="rows__meta">
              <span class="rows__title type-heading-lg">{p.shortTitle}</span>
              <span class="rows__cat type-label">
                {p.category} · {p.location}
              </span>
            </span>
          </a>
        ))}
      </div>
    ))
  }
</section>

<style>
  .rows {
  }

  .rows__head {
    margin-bottom: var(--space-16);
  }

  .rows__head h2 {
    margin-top: var(--space-2);
  }

  /* asymetria: szeroki + wąski, a w co drugim wierszu odwrotnie */
  .rows__row {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }

  .rows__row--swap {
    grid-template-columns: 1fr 1.5fr;
  }

  .rows__media {
    display: block;
    overflow: hidden;
  }

  .rows__media img {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .rows__item:hover .rows__media img {
    transform: scale(1.04);
  }

  .rows__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .rows__title {
    transition: color 0.3s ease;
  }

  .rows__cat {
    flex-shrink: 0;
    color: var(--c-muted);
  }

  @media (max-width: 768px) {
    .rows__row,
    .rows__row--swap {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      margin-bottom: var(--space-8);
    }

    .rows__head {
      margin-bottom: var(--space-8);
    }
  }
</style>
