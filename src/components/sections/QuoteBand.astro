---
// Własny pas: pełna szerokość w kolorze akcentu, jedno duże zdanie.
// Ma przecinać rytm jasnych sekcji i dać oddech przed kolejną treścią.
interface Props {
  text?: string;
  author?: string;
  role?: string;
}

const {
  text = 'Najlepszy projekt to taki, który powstaje warsztatowo, wspólnie.',
  author,
  role,
} = Astro.props;
---

<section class="section section-spaced quote-band">
  <div class="quote-band__inner">
    <p class="quote-band__text type-h2">{text}</p>
    {
      (author || role) && (
        <p class="quote-band__by type-label">
          {author}
          {author && role && <span aria-hidden="true"> · </span>}
          {role && <span class="quote-band__role">{role}</span>}
        </p>
      )
    }
  </div>
</section>

<style>
  .quote-band {
    background: var(--c-accent);
    color: var(--c-on-dark);
  }

  .quote-band__text {
    max-width: 22ch;
  }

  .quote-band__by {
    margin-top: var(--space-8);
  }

  .quote-band__role {
    opacity: 0.7;
  }
</style>
