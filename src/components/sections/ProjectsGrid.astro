---
import { projects } from '../../data/portfolio';
import ArrowLink from '../ArrowLink.astro';
import ProjectCard from '../ProjectCard.astro';

// Asymetryczny wybór realizacji: jedna duża historia i dwie mniejsze.
const featuredSlugs = ['wnetrze-neonatolin', 'mieszkanie-narutowicza', 'osrodek-radacz'];
const items = featuredSlugs.map((slug) => projects.find((project) => project.slug === slug)!);
---

<section class="section section-spaced projects" id="projekty">
  <header class="projects__head section-head-inline">
    <h2>Wybrane realizacje</h2>
    <ArrowLink href="/portfolio/standard-list">Zobacz wszystkie projekty</ArrowLink>
  </header>

  <ul class="projects__grid split-golden--reverse">
    {
      items.map((item, index) => (
        <li>
          <ProjectCard project={item} prominent={index === 0} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .projects__grid {
    display: grid;
    gap: var(--space-16) clamp(var(--space-8), 5vw, var(--space-16));
    align-items: start;
  }

  .projects__grid > li:first-child {
    grid-row: span 2;
  }

  .projects__grid > li:nth-child(3) {
    margin-top: var(--space-8);
  }

  @media (max-width: 1024px) {
    .projects__grid {
      gap: var(--space-12) var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .projects__head {
      margin-bottom: var(--space-8);
    }

    .projects__grid {
      gap: var(--space-8);
    }

    .projects__grid > li:first-child {
      grid-row: auto;
    }

    .projects__grid > li:nth-child(3) {
      margin-top: 0;
    }
  }
</style>
