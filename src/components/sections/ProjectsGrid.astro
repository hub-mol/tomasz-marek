---
import { getProjects } from '../../data/projects';
import ArrowLink from '../ArrowLink.astro';
import ProjectCard from '../ProjectCard.astro';

interface Props {
  title?: string;
  linkLabel?: string;
}

const {title = 'Wybrane realizacje', linkLabel = 'Zobacz wszystkie projekty'} = Astro.props;
const projects = await getProjects();
const featuredProjects = projects.filter((project) => project.featured !== false).slice(0, 4);
---

<section class="projects" id="projekty" data-horizontal-projects>
  <div class="projects__sticky">
    <header class="projects__head section-head-inline">
      <h2 class="type-h1">{title}</h2>
      <ArrowLink href="/portfolio" typeClass="type-h3">{linkLabel}</ArrowLink>
    </header>

    <div class="projects__viewport" data-projects-viewport>
      <ul class="projects__track" data-projects-track>
        {featuredProjects.map((item) => (
          <li class="projects__item">
            <ProjectCard project={item} prominent />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const setupHorizontalProjects = (section: HTMLElement) => {
    const viewport = section.querySelector<HTMLElement>('[data-projects-viewport]');
    const track = section.querySelector<HTMLElement>('[data-projects-track]');
    if (!viewport || !track) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 769px)');
    let distance = 0;
    let leadIn = 0;
    let frame = 0;

    const render = () => {
      frame = 0;
      if (!desktop.matches || reducedMotion.matches || distance <= 0) {
        track.style.transform = '';
        return;
      }
      const progress = Math.min(1, Math.max(0, (-section.getBoundingClientRect().top - leadIn) / distance));
      track.style.transform = `translate3d(${-progress * distance}px, 0, 0)`;
    };

    const requestRender = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };

    const measure = () => {
      const lastItem = track.lastElementChild as HTMLElement | null;
      const gutter = Number.parseFloat(getComputedStyle(track).paddingLeft) || 0;
      distance = Math.max(0, (lastItem?.offsetLeft ?? 0) - gutter);
      leadIn = window.innerHeight * 0.18;
      section.style.setProperty('--scroll-distance', `${distance + leadIn}px`);
      section.toggleAttribute('data-scroll-ready', desktop.matches && !reducedMotion.matches && distance > 0);
      requestRender();
    };

    window.addEventListener('scroll', requestRender, {passive: true});
    window.addEventListener('resize', measure, {passive: true});
    desktop.addEventListener('change', measure);
    reducedMotion.addEventListener('change', measure);
    new ResizeObserver(measure).observe(track);
    measure();
  };

  document.querySelectorAll<HTMLElement>('[data-horizontal-projects]').forEach(setupHorizontalProjects);
</script>

<style>
  .projects {
    --scroll-distance: 0px;
    background: var(--c-bg);
  }

  .projects[data-scroll-ready] {
    height: calc(100svh + var(--scroll-distance));
  }

  .projects__sticky {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-block: clamp(var(--space-12), 7vh, var(--space-24));
    overflow: hidden;
  }

  .projects[data-scroll-ready] .projects__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
  }

  .projects__head {
    padding-inline: var(--gutter);
    margin-bottom: clamp(var(--space-8), 5vh, var(--space-16));
  }

  .projects__viewport {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .projects__viewport::-webkit-scrollbar {
    display: none;
  }

  .projects[data-scroll-ready] .projects__viewport {
    overflow: hidden;
  }

  .projects__track {
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
    width: max-content;
    padding-inline: var(--gutter);
    will-change: transform;
  }

  .projects__item {
    width: clamp(28rem, 50vw, 60rem);
    flex: 0 0 auto;
  }

  @media (max-width: 768px) {
    .projects,
    .projects[data-scroll-ready] {
      height: auto;
    }

    .projects__sticky,
    .projects[data-scroll-ready] .projects__sticky {
      position: static;
      min-height: 0;
      height: auto;
      padding-block: var(--sec-y);
    }

    .projects__head {
      align-items: flex-start;
      margin-bottom: var(--space-8);
    }

    .projects__item {
      width: 84vw;
    }
  }
</style>
