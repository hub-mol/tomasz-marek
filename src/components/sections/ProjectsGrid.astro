---
import { getProjects } from '../../data/projects';
import ArrowLink from '../ArrowLink.astro';
import ProjectCard from '../ProjectCard.astro';

const projects = await getProjects();
const featuredProjects = projects.filter((project) => project.featured !== false).slice(0, 8);
const projectGroups = [
  featuredProjects.slice(0, 3),
  featuredProjects.slice(3, 5),
  featuredProjects.slice(5, 8),
].filter((group) => group.length > 0);
---

<section class="section section-spaced projects" id="projekty">
  <header class="projects__head section-head-inline">
    <h2 class="type-h1">Wybrane realizacje</h2>
    <ArrowLink href="/portfolio/standard-list" typeClass="type-h3">Zobacz wszystkie projekty</ArrowLink>
  </header>

  {projectGroups.map((group, groupIndex) => (
    <ul class:list={['projects__grid', { 'projects__grid--reverse': groupIndex === 2, 'projects__grid--partial': group.length < 3 }]}>
    {
      group.map((item, index) => (
        <li>
          <ProjectCard project={item} prominent={group.length === 3 && index === 0} />
        </li>
      ))
    }
    </ul>
  ))}
</section>

<style>
  .projects__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(17.5rem, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .projects__grid + .projects__grid {
    margin-top: var(--space-8);
  }

  .projects__grid--reverse {
    grid-template-columns: minmax(17.5rem, 1fr) minmax(0, 1.6fr);
  }

  .projects__grid--reverse > li:first-child {
    grid-column: 2;
  }

  .projects__grid--reverse > li:not(:first-child) {
    grid-column: 1;
  }

  .projects__grid--partial {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .projects__grid > li:first-child {
    grid-row: span 2;
  }

  .projects__grid--partial > li:first-child {
    grid-row: auto;
  }

  @media (max-width: 1024px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }

    .projects__grid > li,
    .projects__grid--reverse > li:first-child,
    .projects__grid--reverse > li:not(:first-child) {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (max-width: 768px) {
    .projects__head {
      margin-bottom: var(--space-8);
    }

    .projects__grid > li:first-child {
      grid-row: auto;
    }

  }
</style>
