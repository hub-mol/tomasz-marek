---
// Komponent z portfolio/portfolio-showcase: wielkie zdanie, w które
// wplecione są małe zdjęcia. Zawijanie robi zwykły flex-wrap.
type Part = string | { img: string };

interface Props {
  parts?: Part[];
}

const {
  parts = [
    'Building',
    { img: '/img/tm-1.jpg' },
    'space',
    'from',
    { img: '/img/tm-2.jpg' },
    'the',
    'inside',
    'to',
    'the',
    { img: '/img/tm-3.jpg' },
    'architectual,',
    'outside',
    'project.',
    'We',
    'aim',
    { img: '/img/tm-4.jpg' },
    'to',
    'set',
    'the',
    { img: '/img/tm-5.jpg' },
    'trends',
    { img: '/img/tm-6.jpg' },
    'of',
    'new',
    'creative',
    'solutions.',
  ],
} = Astro.props;
---

<section class="section section-spaced showcase">
  <p class="showcase__line type-h2">
    {
      parts.map((part) =>
        typeof part === 'string' ? (
          <span class="showcase__word">{part}</span>
        ) : (
          <img
            class="showcase__img"
            src={part.img}
            alt=""
            width="103"
            height="63"
            loading="lazy"
          />
        )
      )
    }
  </p>
</section>

<style>
  .showcase {
  }

  .showcase__line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .showcase__word {
    margin-right: var(--space-4);
    padding-right: 0.3125rem;
  }

  .showcase__img {
    width: 6.4375rem;
    height: 3.9375rem;
    margin-right: var(--space-4);
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .showcase__word {
      margin-right: var(--space-2);
      padding-right: 0.1875rem;
    }

    .showcase__img {
      width: 4rem;
      height: 2.5rem;
      margin-right: var(--space-2);
    }
  }
</style>
