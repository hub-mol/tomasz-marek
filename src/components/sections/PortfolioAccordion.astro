---
import ProjectImage from '../ProjectImage.astro';
import ArrowLink from '../ArrowLink.astro';
import { getProjects } from '../../data/projects';

const projects = await getProjects();
---

{
  projects.map((project, index) => (
    <details class="pfa__item" name="projekty" open={index === 0} data-portfolio-preview>
      <summary>
        <span class="section pfa__section">
          <span class="pfa__row">
            <span class="pfa__title type-heading-lg">{project.shortTitle}</span>
            <span class="pfa__area type-body-md">{project.category}{project.location ? ` · ${project.location}` : ''}</span>
            <span class="pfa__surface type-body-md">{project.surface ?? ''}</span>
            <ArrowLink href={`/portfolio/${project.slug}`} class="pfa__link">Zobacz projekt</ArrowLink>
          </span>
        </span>
      </summary>

      <div>
        <div class="section">
          <div class="pfa__body" aria-label={`Galeria projektu ${project.title}`}>
            {[project.img, ...project.gallery].slice(0, 3).map((image, imageIndex) => (
              <ProjectImage
                image={image}
                alt={`${project.alt} — widok ${imageIndex + 1}`}
                widths={[480, 768, 1100]}
                sizes="(max-width: 768px) 100vw, 33vw"
                format="avif"
                loading="lazy"
              />
            ))}
          </div>
        </div>
      </div>
    </details>
  ))
}

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-portfolio-preview]').forEach((item) => {
    const projectLink = item.querySelector<HTMLAnchorElement>('.pfa__link');
    const syncProjectLink = () => {
      if (projectLink) projectLink.tabIndex = item.open ? 0 : -1;
    };

    item.querySelector('summary')?.addEventListener('click', (event) => {
      if (item.open && !(event.target as HTMLElement).closest('a')) {
        event.preventDefault();
      }
    });

    projectLink?.addEventListener('click', (event) => {
      event.stopPropagation();
    });

    item.addEventListener('toggle', syncProjectLink);
    syncProjectLink();
  });
</script>

<style>
  .pfa__item {
    border-bottom: 1px solid var(--c-line);
  }

  .pfa__item > summary {
    cursor: default;
    list-style: none;
  }

  .pfa__item > summary::-webkit-details-marker {
    display: none;
  }

  .pfa__section {
    display: block;
  }

  .pfa__row {
    display: grid;
    grid-template-columns: 1fr 1fr 4rem auto;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-4);
  }

  .pfa__title {
    transition: color 0.3s ease;
  }

  :global(.pfa__link) {
    justify-self: end;
    white-space: nowrap;
    pointer-events: none;
  }

  :global(.pfa__link .arrow-link__label) {
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  :global(.pfa__link .arrow-link__arrow) {
    transform: rotate(-45deg);
  }

  .pfa__item[open] :global(.pfa__link) {
    pointer-events: auto;
  }

  .pfa__item[open] :global(.pfa__link .arrow-link__label) {
    opacity: 1;
  }

  .pfa__item[open] :global(.pfa__link .arrow-link__arrow) {
    transform: rotate(0);
  }

  .pfa__item[open] :global(.pfa__link:hover .arrow-link__arrow) {
    transform: translate(2px, -2px);
  }

  .pfa__body {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    padding-block: var(--space-2) var(--space-8);
  }

  .pfa__body :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1100 / 871;
    object-fit: cover;
  }

  @media (max-width: 1024px) {
    .pfa__row {
      gap: var(--space-1) var(--space-4);
    }
  }

  @media (max-width: 768px) {
    .pfa__row {
      grid-template-columns: 1fr auto;
    }

    .pfa__area,
    .pfa__surface {
      display: none;
    }

    .pfa__body {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
