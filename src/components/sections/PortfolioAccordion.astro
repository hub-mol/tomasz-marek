---
// Układ z portfolio/accordion-list: wiersze tytuł / lokalizacja / rok,
// rozwijane do galerii. Oryginał na jQuery UI — tutaj <details>/<summary>.
const gallery = ['/img/tm-2.jpg', '/img/tm-7.jpg', '/img/tm-6.jpg'];

const items = [
  { title: 'Residence Dubao', area: 'Commercial, Dubai', year: '2021' },
  { title: 'Commercial Bridge', area: 'Hotel, Bali', year: '2021' },
  { title: 'Project No32', area: 'Commercial, Dubai', year: '2021' },
  { title: 'Modern House', area: 'Residental, Dubai', year: '2020' },
  { title: 'Lux Modern Vila', area: 'Residental, Doha', year: '2020' },
  { title: 'Ezu Open Library', area: 'Beijing', year: '2019' },
  { title: 'Project No31', area: 'Commercial, Dubai', year: '2019' },
];
---

<div class="pfa">
  {
    items.map((item, i) => (
      <details class="pfa__item" open={i === 0} name="projekty">
        <summary class="pfa__row">
          <span class="pfa__title">{item.title}</span>
          <span class="pfa__area">{item.area}</span>
          <span class="pfa__year">{item.year}</span>
          <span class="pfa__mark" aria-hidden="true">
            <svg width="11" height="14" viewBox="0 0 10.94 13.423">
              <path d="M5.516 0v12.51" />
              <path d="M10.586 7.6 5.47 12.716.354 7.6" />
            </svg>
          </span>
        </summary>

        <div class="pfa__body">
          {gallery.map((src) => (
            <img src={src} alt="" width="1100" height="871" loading="lazy" />
          ))}
        </div>
      </details>
    ))
  }
</div>

<style>
  .pfa {
    padding-inline: var(--gutter);
  }

  .pfa__item {
    border-bottom: 1px solid var(--c-line);
  }

  .pfa__row {
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 15px 38px;
    cursor: pointer;
    list-style: none;
  }

  .pfa__row::-webkit-details-marker {
    display: none;
  }

  .pfa__title {
    flex: 1 1 45%;
    font-family: var(--ff-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    transition: color 0.3s ease;
  }

  .pfa__area {
    flex: 1 1 45%;
    font-size: 15px;
    line-height: 25px;
  }

  .pfa__year {
    flex: 0 0 auto;
    min-width: 60px;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: -0.45px;
  }

  .pfa__mark svg {
    display: block;
    fill: none;
    stroke: currentColor;
    transition: transform 0.35s ease;
  }

  .pfa__item[open] .pfa__mark svg {
    transform: rotate(180deg);
  }

  .pfa__row:hover .pfa__title {
    color: var(--c-accent);
  }

  .pfa__body {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    padding: 8px 38px 38px;
  }

  .pfa__body img {
    width: 100%;
    height: auto;
    aspect-ratio: 1100 / 871;
    object-fit: cover;
  }

  @media (max-width: 1024px) {
    .pfa__row {
      flex-wrap: wrap;
      gap: 4px 20px;
      padding-inline: 0;
    }

    .pfa__title {
      flex-basis: 100%;
    }

    .pfa__area {
      flex: 1 1 auto;
    }

    .pfa__body {
      padding-inline: 0;
    }
  }

  @media (max-width: 768px) {
    .pfa__body {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
