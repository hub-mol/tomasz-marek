---
import ProjectImage from '../ProjectImage.astro';
import ArrowLink from '../ArrowLink.astro';
import { getProjects } from '../../data/projects';

const projects = await getProjects();
---

{
  projects.map((project, index) => {
    const previewImages = [project.img, ...project.gallery].slice(0, 2);

    return <details class="pfa__item" name="projekty" open={index === 0} data-portfolio-preview>
      <summary>
        <span class="section pfa__section">
          <span class="pfa__row">
            <span class="pfa__title type-heading-lg">{project.shortTitle}</span>
            <span class="pfa__meta">
              <span class="pfa__area type-body-md">{project.category}{project.location ? ` · ${project.location}` : ''}</span>
              <span class="pfa__surface type-body-md">{project.surface ?? ''}</span>
            </span>
            <span class="pfa__indicator" aria-hidden="true">
              <svg viewBox="0 0 16 16">
                <path d="M1.25 14.75 14.75 1.25" />
                <path d="M4.125 1.25H14.75v10.625" />
              </svg>
            </span>
          </span>
        </span>
      </summary>

      <div>
        <div class="section">
          <div class="pfa__body" aria-label={`Galeria projektu ${project.title}`}>
            {previewImages.map((image, imageIndex) => (
              <div class:list={['pfa__image', {'pfa__image--secondary': imageIndex === 1}]}>
                <ProjectImage
                  image={image}
                  alt={`${project.alt} — widok ${imageIndex + 1}`}
                  widths={[480, 768, 1100]}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  format="avif"
                  loading="lazy"
                />
              </div>
            ))}
            {previewImages.length < 2 && <div class="pfa__image-placeholder" aria-hidden="true" />}
            <ArrowLink href={`/portfolio/${project.slug}`} class="pfa__link" typeClass="type-h3">Zobacz projekt</ArrowLink>
          </div>
        </div>
      </div>
    </details>;
  })
}

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-portfolio-preview]').forEach((item) => {
    item.querySelector('summary')?.addEventListener('click', (event) => {
      if (item.open) {
        event.preventDefault();
      }
    });
  });
</script>

<style>
  .pfa__item {
    border-bottom: 1px solid var(--c-line);
  }

  .pfa__item > summary {
    cursor: default;
    list-style: none;
  }

  .pfa__item:not([open]) > summary {
    cursor: pointer;
  }

  .pfa__item > summary::-webkit-details-marker {
    display: none;
  }

  .pfa__section {
    display: block;
  }

  .pfa__row {
    display: grid;
    grid-template-columns: 1fr 1.4fr 0.6fr;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-4);
  }

  .pfa__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .pfa__title {
    transition: color 0.3s ease;
  }

  .pfa__indicator {
    justify-self: end;
  }

  .pfa__indicator svg {
    display: block;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5px;
    stroke-linejoin: round;
    transform: rotate(135deg);
    transition: transform 0.3s cubic-bezier(0.16, 0.48, 0.36, 1);
  }

  .pfa__item[open] .pfa__indicator svg {
    transform: rotate(-45deg);
  }

  :global(.pfa__link) {
    align-self: end;
    justify-self: end;
    white-space: nowrap;
  }

  .pfa__body {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    padding-block: var(--space-2) var(--space-8);
  }

  .pfa__body :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1100 / 871;
    object-fit: cover;
  }

  @media (max-width: 1024px) {
    .pfa__row {
      gap: var(--space-1) var(--space-4);
    }
  }

  @media (max-width: 768px) {
    .pfa__row {
      grid-template-columns: 1fr auto;
    }

    .pfa__meta {
      display: none;
    }

    .pfa__body {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .pfa__image--secondary,
    .pfa__image-placeholder {
      display: none;
    }

    :global(.pfa__link) {
      align-self: auto;
    }
  }
</style>
