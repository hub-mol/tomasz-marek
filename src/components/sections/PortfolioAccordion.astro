---
import ProjectImage from '../ProjectImage.astro';
import ArrowLink from '../ArrowLink.astro';
import { getProjects } from '../../data/projects';

const projects = await getProjects();
---

{
  projects.map((project, index) => (
    <details class="pfa__item" name="projekty" open={index === 0} data-portfolio-preview>
      <summary>
        <span class="section pfa__section">
          <span class="pfa__row">
            <span class="pfa__title type-heading-lg">{project.shortTitle}</span>
            <span class="pfa__area type-body-md">{project.category}{project.location ? ` · ${project.location}` : ''}</span>
            <span class="pfa__surface type-body-md">{project.surface ?? ''}</span>
            <ArrowLink href={`/portfolio/${project.slug}`} class="pfa__link">Zobacz projekt</ArrowLink>
          </span>
        </span>
      </summary>

      <div>
        <div class="section">
          <div class="pfa__body" aria-label={`Galeria projektu ${project.title}`}>
            {[project.img, ...project.gallery].slice(0, 3).map((image, imageIndex) => (
              <ProjectImage
                image={image}
                alt={`${project.alt} — widok ${imageIndex + 1}`}
                widths={[480, 768, 1100]}
                sizes="(max-width: 768px) 100vw, 33vw"
                format="avif"
                loading="lazy"
              />
            ))}
          </div>
        </div>
      </div>
    </details>
  ))
}

<script>
  const supportsHover = window.matchMedia('(hover: hover) and (pointer: fine)');

  document.querySelectorAll<HTMLDetailsElement>('[data-portfolio-preview]').forEach((item) => {
    item.addEventListener('mouseenter', () => {
      if (supportsHover.matches) item.open = true;
    });

    item.querySelector('summary')?.addEventListener('click', (event) => {
      if (item.open && !(event.target as HTMLElement).closest('a')) {
        event.preventDefault();
      }
    });

    item.querySelector('.pfa__link')?.addEventListener('click', (event) => {
      event.stopPropagation();
    });
  });
</script>

<style>
  .pfa__item {
    border-bottom: 1px solid var(--c-line);
  }

  .pfa__item > summary {
    cursor: pointer;
    list-style: none;
  }

  .pfa__item > summary::-webkit-details-marker {
    display: none;
  }

  .pfa__section {
    display: block;
  }

  .pfa__row {
    display: grid;
    grid-template-columns: 1fr 1fr 4rem auto;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-4);
  }

  .pfa__title {
    transition: color 0.3s ease;
  }

  .pfa__link {
    justify-self: end;
    white-space: nowrap;
  }

  .pfa__body {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    padding-block: var(--space-2) var(--space-8);
  }

  .pfa__body :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1100 / 871;
    object-fit: cover;
  }

  @media (max-width: 1024px) {
    .pfa__row {
      gap: var(--space-1) var(--space-4);
    }
  }

  @media (max-width: 768px) {
    .pfa__body {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
