---
// Własny układ: lewa kolumna zostaje w kadrze (position: sticky),
// prawa przewija się zdjęciami. Bez JS.
interface Krok {
  label: string;
  text: string;
  img: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  steps?: Krok[];
}

const {
  eyebrow = 'Proces',
  title = 'Projekt powstaje warsztatowo.',
  steps = [
    {
      label: 'Miejsce',
      text: 'Zaczynam od działki: nasłonecznienia, widoków, sąsiedztwa i tego, co wolno na niej zbudować.',
      img: '/img/tm-3.jpg',
    },
    {
      label: 'Układ',
      text: 'Sprawdzamy warianty rozkładu pomieszczeń i relacji między strefami, zanim cokolwiek zostanie przesądzone.',
      img: '/img/tm-6.jpg',
    },
    {
      label: 'Materiał',
      text: 'Dobieram rozwiązania, które da się wykonać w założonym budżecie i które ze sobą współgrają.',
      img: '/img/tm-1.jpg',
    },
  ],
} = Astro.props;
---

<section class="section sticky-feat">
  <div class="sticky-feat__aside">
    <div class="sticky-feat__pin">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="sticky-feat__title">{title}</h2>
    </div>
  </div>

  <div class="sticky-feat__stream">
    {
      steps.map((s, i) => (
        <article class="sticky-feat__step">
          <img src={s.img} alt="" width="1100" height="800" loading="lazy" />
          <div class="sticky-feat__body">
            <span class="sticky-feat__num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="sticky-feat__label">{s.label}</h3>
              <p class="sticky-feat__text">{s.text}</p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .sticky-feat {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(0, 1.6fr);
    gap: clamp(60px, 8vw, 150px);
    padding-block: var(--sec-y);
  }

  /* kolumna tekstowa zostaje w kadrze, dopóki obok przewijają się kroki */
  .sticky-feat__pin {
    position: sticky;
    top: calc(var(--hdr-h) + 40px);
  }

  .sticky-feat__title {
    margin-top: 12px;
  }

  .sticky-feat__step + .sticky-feat__step {
    margin-top: 90px;
  }

  .sticky-feat__step img {
    width: 100%;
    height: auto;
    aspect-ratio: 11 / 8;
    object-fit: cover;
  }

  .sticky-feat__body {
    display: flex;
    gap: 16px;
    margin-top: 22px;
  }

  .sticky-feat__num {
    flex-shrink: 0;
    min-width: 34px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--c-gray);
    font-variant-numeric: tabular-nums;
  }

  .sticky-feat__label {
    margin-bottom: 6px;
  }

  .sticky-feat__text {
    max-width: 52ch;
    color: var(--c-muted);
  }

  @media (max-width: 1024px) {
    .sticky-feat {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    /* bez drugiej kolumny przyklejanie traci sens */
    .sticky-feat__pin {
      position: static;
    }

    .sticky-feat__step + .sticky-feat__step {
      margin-top: 60px;
    }
  }
</style>
