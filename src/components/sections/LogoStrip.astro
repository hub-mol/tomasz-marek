---
// Odpowiednik `clients_list` z dema: pas logotypów. Tutaj jako miejsce na
// wykonawców, dostawców albo publikacje branżowe.
interface Props {
  eyebrow?: string;
  logos?: string[];
}

const {
  eyebrow = 'Zaufali i współpracują',
  logos = [
    '/img/client-1.png',
    '/img/client-2.png',
    '/img/client-3.png',
    '/img/client-4.png',
    '/img/client-5.png',
    '/img/client-6.png',
  ],
} = Astro.props;
---

<section class="section logos">
  <p class="eyebrow logos__label">{eyebrow}</p>
  <ul class="logos__grid">
    {
      logos.map((src) => (
        <li>
          <img src={src} alt="" width="120" height="48" loading="lazy" />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .logos {
    padding-block: 90px;
    border-top: 1px solid var(--c-line);
  }

  .logos__label {
    margin-bottom: 40px;
  }

  .logos__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: center;
    gap: 50px;
  }

  .logos__grid img {
    width: auto;
    max-width: 100%;
    height: 34px;
    object-fit: contain;
    /* logotypy z dema bywają kolorowe — sprowadzamy je do jednego tonu */
    filter: grayscale(1);
    opacity: 0.45;
    transition: opacity 0.3s ease;
  }

  .logos__grid li:hover img {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .logos__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }

  @media (max-width: 768px) {
    .logos {
      padding-block: 60px;
    }

    .logos__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }
</style>
