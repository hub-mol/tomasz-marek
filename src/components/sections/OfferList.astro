---
import { plNoBreak } from '../../utils/typography';

export interface OfferGroup {
  title: string;
  lead?: string;
  sections: Array<{title: string; text: string}>;
}

interface Props {
  title?: string;
  offers?: OfferGroup[];
}

const defaultOffers = [
  {
    title: 'Klienci indywidualni',
    lead: 'Planujesz budowę domu, przebudowę lub remont?',
    sections: [
      {
        title: 'Architektura',
        text: 'Indywidualne projekty domów i rezydencji — od koncepcji po projekt budowlany, techniczny, koordynację branż i nadzór autorski.',
      },
      {
        title: 'Wnętrza',
        text: 'Kompleksowe projekty wnętrz prywatnych — od układu funkcjonalnego i koncepcji po materiały, wizualizacje oraz dokumentację wykonawczą.',
      },
    ],
  },
  {
    title: 'Biznes',
    lead: 'Potrzebujesz funkcjonalnej przestrzeni spójnej z charakterem marki?',
    sections: [
      {
        title: 'Architektura',
        text: 'Projekty obiektów usługowych, komercyjnych i mieszkaniowych — od koncepcji po dokumentację, koordynację branż oraz nadzór realizacji.',
      },
      {
        title: 'Wnętrza',
        text: 'Projekty biur, gastronomii, lokali usługowych i innych wnętrz komercyjnych — funkcjonalnych, spójnych i zgodnych z charakterem marki.',
      },
    ],
  },
  {
    title: 'Doradztwo',
    lead: 'Planujesz zakup działki i chcesz sprawdzić jej potencjał?',
    sections: [
      {
        title: 'Analizy',
        text: 'Analizujemy możliwości zabudowy, zapisy MPZP lub WZ oraz potencjał działki albo nieruchomości przed zakupem i rozpoczęciem inwestycji.',
      },
      {
        title: 'Konsultacje',
        text: 'Doradzamy przed zakupem działki lub nieruchomości, pomagamy ocenić planowane zamierzenie i wspieramy proces uzyskania warunków zabudowy.',
      },
    ],
  },
];

const {title = 'Zakres współpracy', offers = defaultOffers} = Astro.props;
const getLead = (offer: OfferGroup) => offer.lead
  ?? defaultOffers.find((item) => item.title === offer.title)?.lead;
---

<section class="section section-spaced offer" id="oferta">
  <header class="offer__head section-head split-golden">
    <p class="tagline">Oferta</p>
    <h2>{title}</h2>
  </header>

  <ul class="offer__grid">
    {offers.map((offer) => (
      <li class="offer__item">
        <div class="offer__intro">
          {getLead(offer) && <p class="offer__lead">{plNoBreak(getLead(offer)!)}</p>}
          <h3 class="offer__title type-h3">{offer.title}</h3>
        </div>

        <div class="offer__sections">
          {offer.sections.map((section) => (
            <section class="offer__section">
              <h3 class="tagline">{section.title}</h3>
              <p>{plNoBreak(section.text)}</p>
            </section>
          ))}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .offer {
    background: var(--c-bg-alt);
  }

  .offer__head h2 {
    white-space: nowrap;
  }

  .offer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    border: 1px solid var(--c-line);
  }

  .offer__item {
    display: grid;
    grid-template-rows: minmax(12.5rem, auto) repeat(2, minmax(11.875rem, 1fr));
    border-right: 1px solid var(--c-line);
  }

  .offer__item:last-child {
    border-right: 0;
  }

  .offer__intro {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-8);
    border-bottom: 1px solid var(--c-line);
  }

  .offer__title {
    margin: 0;
  }

  .offer__lead {
    max-width: 30ch;
    margin: 0;
    color: var(--c-muted);
  }

  .offer__sections {
    display: contents;
  }

  .offer__section {
    padding: var(--space-8);
  }

  .offer__section + .offer__section {
    margin: 0;
    border-top: 1px solid var(--c-line);
  }

  .offer__section h4 {
    margin-bottom: 0;
  }

  .offer__section p {
    margin-top: var(--space-2);
    color: var(--c-muted);
  }

  @media (max-width: 1024px) {
    .offer__grid {
      grid-template-columns: 1fr;
    }

    .offer__item,
    .offer__item + .offer__item {
      display: grid;
      grid-template-rows: minmax(10rem, auto) repeat(2, minmax(9.375rem, auto));
      border-right: 0;
      border-bottom: 1px solid var(--c-line);
    }

    .offer__item:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .offer__head {
      margin-bottom: var(--space-12);
    }

    .offer__item,
    .offer__item + .offer__item {
      grid-template-rows: auto repeat(2, auto);
    }
  }
</style>
