---
import { plNoBreak } from '../../utils/typography';

const offers = [
  {
    title: 'Klienci indywidualni',
    sections: [
      {
        title: 'Architektura',
        text: 'Indywidualne projekty domów i rezydencji — od koncepcji po projekt budowlany, techniczny, koordynację branż i nadzór autorski.',
      },
      {
        title: 'Wnętrza',
        text: 'Kompleksowe projekty wnętrz prywatnych — od układu funkcjonalnego i koncepcji po materiały, wizualizacje oraz dokumentację wykonawczą.',
      },
    ],
  },
  {
    title: 'Biznes',
    sections: [
      {
        title: 'Architektura',
        text: 'Projekty obiektów usługowych, komercyjnych i mieszkaniowych — od koncepcji po dokumentację, koordynację branż oraz nadzór realizacji.',
      },
      {
        title: 'Wnętrza',
        text: 'Projekty biur, gastronomii, lokali usługowych i innych wnętrz komercyjnych — funkcjonalnych, spójnych i zgodnych z charakterem marki.',
      },
    ],
  },
  {
    title: 'Doradztwo',
    sections: [
      {
        title: 'Analizy',
        text: 'Analizujemy możliwości zabudowy, zapisy MPZP lub WZ oraz potencjał działki albo nieruchomości przed zakupem i rozpoczęciem inwestycji.',
      },
      {
        title: 'Konsultacje',
        text: 'Doradzamy przed zakupem działki lub nieruchomości, pomagamy ocenić planowane zamierzenie i wspieramy proces uzyskania warunków zabudowy.',
      },
    ],
  },
];
---

<section class="section offer" id="oferta">
  <header class="offer__head split-golden">
    <p class="offer__eyebrow eyebrow">Oferta</p>
    <h2>Zakres współpracy</h2>
  </header>

  <ol class="offer__grid">
    {offers.map((offer, i) => (
      <li class="offer__item">
        <span class="offer__num">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="offer__title">{offer.title}</h3>

        <div class="offer__sections">
          {offer.sections.map((section) => (
            <section class="offer__section">
              <h4>{section.title}</h4>
              <p>{plNoBreak(section.text)}</p>
            </section>
          ))}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .offer {
    padding-top: 135px;
    padding-bottom: 145px;
    background: var(--c-bg-alt);
  }

  .offer__head {
    margin-bottom: 75px;
  }

  .offer__eyebrow {
    padding-top: 8px;
  }

  .offer__head h2 {
    justify-self: end;
    font-size: clamp(2.7rem, 5vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-align: right;
  }

  .offer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    border: 1px solid var(--c-line);
  }

  .offer__item {
    display: grid;
    grid-template-rows: 65px 145px repeat(2, minmax(190px, 1fr));
    border-right: 1px solid var(--c-line);
  }

  .offer__item:last-child {
    border-right: 0;
  }

  .offer__num {
    display: block;
    padding: 32px;
    color: var(--c-gray);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .offer__title {
    display: flex;
    align-items: flex-end;
    margin: 0;
    padding: 32px;
    border-bottom: 1px solid var(--c-line);
    font-size: clamp(1.8rem, 2.5vw, 3rem);
    line-height: 1.05;
  }

  .offer__sections {
    display: contents;
  }

  .offer__section {
    padding: 32px;
  }

  .offer__section + .offer__section {
    margin: 0;
    border-top: 1px solid var(--c-line);
  }

  .offer__section h4 {
    font-family: var(--ff);
    font-size: 13px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .offer__section p {
    margin-top: 12px;
    color: var(--c-muted);
  }

  @media (max-width: 1024px) {
    .offer {
      padding-top: 100px;
      padding-bottom: 105px;
    }

    .offer__grid {
      grid-template-columns: 1fr;
    }

    .offer__item,
    .offer__item + .offer__item {
      display: grid;
      grid-template-rows: 60px 120px repeat(2, minmax(150px, auto));
      border-right: 0;
      border-bottom: 1px solid var(--c-line);
    }

    .offer__item:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .offer {
      padding-top: 75px;
      padding-bottom: 80px;
    }

    .offer__head {
      margin-bottom: 50px;
    }

    .offer__item,
    .offer__item + .offer__item {
      grid-template-rows: 55px auto repeat(2, auto);
    }
  }
</style>
