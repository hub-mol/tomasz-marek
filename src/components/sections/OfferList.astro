---
import { plNoBreak } from '../../utils/typography';

const offers = [
  {
    title: 'Klienci indywidualni',
    sections: [
      {
        title: 'Architektura',
        text: 'Indywidualne projekty domów i rezydencji — od koncepcji po projekt budowlany, techniczny, koordynację branż i nadzór autorski.',
      },
      {
        title: 'Wnętrza',
        text: 'Kompleksowe projekty wnętrz prywatnych — od układu funkcjonalnego i koncepcji po materiały, wizualizacje oraz dokumentację wykonawczą.',
      },
    ],
  },
  {
    title: 'Biznes',
    sections: [
      {
        title: 'Architektura',
        text: 'Projekty obiektów usługowych, komercyjnych i mieszkaniowych — od koncepcji po dokumentację, koordynację branż oraz nadzór realizacji.',
      },
      {
        title: 'Wnętrza',
        text: 'Projekty biur, gastronomii, lokali usługowych i innych wnętrz komercyjnych — funkcjonalnych, spójnych i zgodnych z charakterem marki.',
      },
    ],
  },
  {
    title: 'Doradztwo',
    sections: [
      {
        title: 'Analizy',
        text: 'Analizujemy możliwości zabudowy, zapisy MPZP lub WZ oraz potencjał działki albo nieruchomości przed zakupem i rozpoczęciem inwestycji.',
      },
      {
        title: 'Konsultacje',
        text: 'Doradzamy przed zakupem działki lub nieruchomości, pomagamy ocenić planowane zamierzenie i wspieramy proces uzyskania warunków zabudowy.',
      },
    ],
  },
];
---

<section class="section section-spaced offer" id="oferta">
  <header class="offer__head section-head split-golden">
    <p class="tagline">Oferta</p>
    <h2>Zakres współpracy</h2>
  </header>

  <ol class="offer__grid">
    {offers.map((offer, i) => (
      <li class="offer__item">
        <span class="offer__num type-body-sm">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="offer__title type-h3">{offer.title}</h3>

        <div class="offer__sections">
          {offer.sections.map((section) => (
            <section class="offer__section">
              <h3 class="tagline">{section.title}</h3>
              <p>{plNoBreak(section.text)}</p>
            </section>
          ))}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .offer {
    background: var(--c-bg-alt);
  }

  .offer__head h2 {
    white-space: nowrap;
  }

  .offer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    border: 1px solid var(--c-line);
  }

  .offer__item {
    display: grid;
    grid-template-rows: 4.0625rem 9.0625rem repeat(2, minmax(11.875rem, 1fr));
    border-right: 1px solid var(--c-line);
  }

  .offer__item:last-child {
    border-right: 0;
  }

  .offer__num {
    display: block;
    padding: var(--space-8);
    color: var(--c-gray);
  }

  .offer__title {
    display: flex;
    align-items: flex-end;
    margin: 0;
    padding: var(--space-8);
    border-bottom: 1px solid var(--c-line);
  }

  .offer__sections {
    display: contents;
  }

  .offer__section {
    padding: var(--space-8);
  }

  .offer__section + .offer__section {
    margin: 0;
    border-top: 1px solid var(--c-line);
  }

  .offer__section h4 {
    margin-bottom: 0;
  }

  .offer__section p {
    margin-top: var(--space-2);
    color: var(--c-muted);
  }

  @media (max-width: 1024px) {
    .offer__grid {
      grid-template-columns: 1fr;
    }

    .offer__item,
    .offer__item + .offer__item {
      display: grid;
      grid-template-rows: 3.75rem 7.5rem repeat(2, minmax(9.375rem, auto));
      border-right: 0;
      border-bottom: 1px solid var(--c-line);
    }

    .offer__item:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .offer__head {
      margin-bottom: var(--space-12);
    }

    .offer__item,
    .offer__item + .offer__item {
      grid-template-rows: 3.4375rem auto repeat(2, auto);
    }
  }
</style>
