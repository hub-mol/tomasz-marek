---
import ArrowLink from '../ArrowLink.astro';

// Sekcja "Making sure…" z podstrony Our Services.
// Lewa kolumna: tytuł + czerwony przycisk. Prawa: 5 usług w dwóch kolumnach (3 + 2).
const items = [
  {
    icon: '/icons/svc-planning.svg',
    title: 'Oczekiwania inwestora',
    text: 'Wsłuchuję się w oczekiwania i trafnie przekładam wytyczne inwestora na język architektury.',
  },
  {
    icon: '/icons/svc-artisans.svg',
    title: 'Praca warsztatowa',
    text: 'Proces projektowy prowadzę w trybie warsztatowym, w bezpośredniej współpracy architekta i inwestora.',
  },
  {
    icon: '/icons/svc-residences.svg',
    title: 'Porównywanie wariantów',
    text: 'Wspólnie weryfikujemy różne opcje projektu, zanim wybierzemy kierunek rozwijany w kolejnych etapach.',
  },
  {
    icon: '/icons/svc-3d-modelling.svg',
    title: 'Swoboda zmian',
    text: 'Proces daje łatwość i swobodę wprowadzania zmian na etapie, na którym można je świadomie przeanalizować.',
  },
  {
    icon: '/icons/svc-floor-plans.svg',
    title: 'Świadome decyzje',
    text: 'Dobra i przemyślana architektura powstaje jako efekt procesu oraz wielu wzajemnie powiązanych decyzji.',
  },
];
---

<section class="section section--alt making">
  <div class="making__aside">
    <h2 class="making__title">
      Prowadzi nas proces.
    </h2>
    <ArrowLink href="/#kontakt">Porozmawiajmy o projekcie</ArrowLink>
  </div>

  <ul class="making__grid">
    {
      items.map((item) => (
        <li class="making__item">
          <img class="making__icon" src={item.icon} alt="" width="48" height="56" />
          <h3 class="making__name">{item.title}</h3>
          <p class="making__text">{item.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .making {
    padding-block: 7.8125rem 8.4375rem;
  }

  .making__aside {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: 4.6875rem;
  }

  .making__title {
    max-width: 34.375rem;
  }

  .making__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid var(--c-line);
  }

  .making__item {
    padding: var(--space-8) var(--space-8) 0 0;
    border-right: 1px solid var(--c-line);
  }

  .making__item + .making__item {
    padding-left: var(--space-8);
  }

  .making__icon {
    width: auto;
    height: 3.5rem;
  }

  .making__name {
    margin-top: var(--space-4);
    line-height: var(--leading-md);
  }

  .making__text {
    margin-top: var(--space-4);
  }

  @media (max-width: 1024px) {
    .making {
      padding-block: 6.25rem;
    }

    .making__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-12) 0;
    }

    .making__item {
      padding-right: var(--space-8);
      border-right: 0;
    }

    .making__item:nth-child(even) {
      padding-left: var(--space-8);
      border-left: 1px solid var(--c-line);
    }
  }

  @media (max-width: 768px) {
    .making__aside {
      display: block;
      margin-bottom: var(--space-12);
    }

    .making__aside :global(a) {
      margin-top: var(--space-6);
    }

    .making__grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .making__item,
    .making__item + .making__item,
    .making__item:nth-child(even) {
      padding: 0;
      border: 0;
    }
  }
</style>
