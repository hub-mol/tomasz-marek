---
import ArrowLink from '../ArrowLink.astro';
import { plNoBreak } from '../../utils/typography';
import heroImage from '../../assets/images/hero-0.jpg';
import ProjectImage from '../ProjectImage.astro';
import type {ProjectImage as ProjectImageType} from '../../data/portfolio';

interface Props {
  title?: string;
  titleStart?: string;
  titleEnd?: string;
  text?: string;
  img?: ProjectImageType;
  alt?: string;
}

const {
  title = 'Architektura zainspirowana miejscem i ludźmi.',
  titleStart,
  titleEnd,
  text = 'Od idei po realizację poprowadzimy Cię przez cały proces projektowy i wykonawczy.',
  img = heroImage,
  alt = 'Wizualizacja projektu architektonicznego autorstwa Tomasza Marka',
} = Astro.props;
---

<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <ProjectImage
      image={img}
      alt={alt}
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero__content">
    <h1 class="hero__title type-h1">
      {titleStart && titleEnd ? (
        <>{plNoBreak(titleStart)}<span class="hero__star">*</span>{plNoBreak(titleEnd)}</>
      ) : plNoBreak(title)}
    </h1>
    <div class="hero__aside">
      <p class="hero__note type-heading-lg">{plNoBreak(text)}</p>
      <ArrowLink href="/#kontakt">Umów konsultację z&nbsp;architektem</ArrowLink>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 38.75rem;
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.1);
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: cover;
    object-position: bottom;
    user-select: none;
  }

  .hero__content {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(17.5rem, 1fr);
    gap: var(--space-16) clamp(var(--space-8), 5vw, var(--space-16));
    align-items: end;
    padding-inline: var(--gutter);
    padding-bottom: clamp(var(--space-12), 8vh, var(--space-24));
  }

  .hero__title {
    max-width: 18ch;
    margin: 0;
    /* nagłówek łamiemy ręcznie znakami nowej linii z propsa */
    white-space: pre-line;
  }

  .hero__star {
    color: var(--c-accent);
  }

  .hero__aside :global(.arrow-link) {
    margin-top: var(--space-6);
  }

  @media (max-width: 768px) {
    .hero__content {
      grid-template-columns: 1fr;
      padding-bottom: var(--space-8);
    }
  }
</style>
