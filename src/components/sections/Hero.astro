---
import ArrowLink from '../ArrowLink.astro';
import { plNoBreak } from '../../utils/typography';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroImage from '../../assets/images/hero-0.jpg';

interface Props {
  title?: string;
  titleStart?: string;
  titleEnd?: string;
  text?: string;
  img?: ImageMetadata;
}

const {
  title = 'Tworzę architekturę.\nInspiruję się miejscem i ludźmi',
  titleStart,
  titleEnd,
  text = 'Od pierwszej idei po dokumentację i realizację prowadzimy inwestora przez cały proces projektowy',
  img = heroImage,
} = Astro.props;
---

<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <Image
      src={img}
      alt="Wizualizacja projektu architektonicznego autorstwa Tomasza Marka"
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero__content">
    <h1 class="hero__title">
      {titleStart && titleEnd ? (
        <>{plNoBreak(titleStart)}<span class="hero__star">*</span>{plNoBreak(titleEnd)}</>
      ) : plNoBreak(title)}
    </h1>
    <div class="hero__aside">
      <p class="hero__note">{plNoBreak(text)}</p>
      <ArrowLink href="/#kontakt">Konsultacja z&nbsp;architektem</ArrowLink>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 38.75rem;
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.1);
  }

  .hero__media img {
    width: 100%;
    height: 120%;
    object-fit: cover;
    transform: translateY(-10%);
  }

  /* Nagłówek i dopisek stoją w jednym rzędzie, oba dosunięte do dołu:
     nagłówek do lewej, dopisek do prawej krawędzi komponentu.
     Padding dolny równy bocznym. */
  .hero__content {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-12);
    padding-inline: var(--gutter);
    padding-bottom: clamp(var(--space-12), 8vh, var(--space-24));
  }

  .hero__title {
    max-width: 18ch;
    margin: 0;
    font-size: var(--h1);
    line-height: 1.02;
    /* nagłówek łamiemy ręcznie znakami nowej linii z propsa */
    white-space: pre-line;
    letter-spacing: -0.03em;
    font-weight: 500;
  }

  .hero__aside {
    max-width: 39ch;
    text-align: right;
  }

  .hero__star {
    color: var(--c-accent);
  }

  .hero__note {
    font-family: var(--ff-heading);
    font-size: var(--text-lg);
    line-height: var(--leading-xl);
    letter-spacing: var(--tracking-tight);
  }

  .hero__aside :global(.arrow-link) {
    margin-top: var(--space-6);
  }

  @media (max-width: 768px) {

    /* na wąskim ekranie dopisek schodzi pod nagłówek */
    .hero__content {
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: var(--space-8);
    }

    .hero__aside {
      text-align: left;
    }

  }
</style>
