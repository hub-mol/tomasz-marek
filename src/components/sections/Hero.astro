---
import ArrowLink from '../ArrowLink.astro';
import BrandLogo from '../BrandLogo.astro';
import { plNoBreak } from '../../utils/typography';
import heroImage from '../../assets/images/hero-0.jpg';
import ProjectImage from '../ProjectImage.astro';
import type {ProjectImage as ProjectImageType} from '../../data/portfolio';

interface Props {
  text?: string;
  img?: ProjectImageType;
  images?: ProjectImageType[];
  alt?: string;
}

const {
  text = 'Od idei po realizację poprowadzimy Cię przez cały proces projektowy i wykonawczy.',
  img = heroImage,
  images,
  alt = 'Wizualizacja projektu architektonicznego autorstwa Tomasza Marka',
} = Astro.props;

const slides = images?.length ? images.slice(0, 3) : [img];
const hasSlideshow = slides.length > 1;
---

<section class="hero">
  <div
    class:list={['hero__media', {'hero__media--slideshow': hasSlideshow}]}
    data-hero-slideshow={hasSlideshow ? '' : undefined}
    aria-hidden="true"
  >
    {slides.map((slide, index) => (
      <div class="hero__slide" style={`--slide-index: ${index}; --slide-count: ${slides.length};`}>
        <ProjectImage
          image={slide}
          alt={slide && 'alt' in slide ? slide.alt ?? alt : alt}
          widths={[480, 768, 1280, 1920, 2400]}
          sizes="100vw"
          format="avif"
          loading="eager"
          fetchpriority={index === 0 ? 'high' : 'low'}
          decoding={index === 0 ? 'sync' : 'async'}
        />
      </div>
    ))}
  </div>

  <div class="hero__content">
    <BrandLogo class="hero__brand" />
    <div class="hero__aside">
      <p class="hero__note type-heading-lg">{plNoBreak(text)}</p>
      <ArrowLink href="/#kontakt">Umów konsultację z&nbsp;architektem</ArrowLink>
    </div>
  </div>
</section>

<script>
  const prepareHeroSlideshows = () => {
    document.querySelectorAll<HTMLElement>('[data-hero-slideshow]').forEach(async (slideshow) => {
      if (slideshow.dataset.ready !== undefined) return;
      slideshow.dataset.ready = '';

      const images = [...slideshow.querySelectorAll<HTMLImageElement>('.hero__slide img')];
      await Promise.all(images.map(async (image) => {
        if (!image.complete) {
          await new Promise<void>((resolve) => {
            image.addEventListener('load', () => resolve(), {once: true});
            image.addEventListener('error', () => resolve(), {once: true});
          });
        }

        await image.decode().catch(() => undefined);
      }));

      slideshow.classList.add('hero__media--ready');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const slides = [...slideshow.querySelectorAll<HTMLElement>('.hero__slide')];
      let currentIndex = 0;
      slides[currentIndex]?.classList.add('hero__slide--active');
      slides[(currentIndex + 1) % slides.length]?.classList.add('hero__slide--next');

      window.setInterval(() => {
        const current = slides[currentIndex];
        const nextIndex = (currentIndex + 1) % slides.length;
        const next = slides[nextIndex];
        const following = slides[(nextIndex + 1) % slides.length];
        if (!current || !next || !following) return;

        current.classList.add('hero__slide--leaving');

        window.setTimeout(() => {
          current.classList.remove('hero__slide--active', 'hero__slide--leaving');
          next.classList.remove('hero__slide--next');
          next.classList.add('hero__slide--active');
          following.classList.add('hero__slide--next');
          currentIndex = nextIndex;
        }, 1100);
      }, 6000);
    });
  };

  prepareHeroSlideshows();
  document.addEventListener('astro:page-load', prepareHeroSlideshows);
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 38.75rem;
    overflow: hidden;
    background: var(--c-bg-dark);
    color: var(--c-on-dark);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    isolation: isolate;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
  }

  .hero__media--slideshow .hero__slide {
    opacity: 0;
    z-index: 0;
    transition: opacity 1.1s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero__media--slideshow .hero__slide:first-child {
    opacity: 1;
  }

  .hero__media--slideshow .hero__slide--active {
    z-index: 2;
    opacity: 1;
  }

  .hero__media--slideshow .hero__slide--next {
    z-index: 1;
    opacity: 1;
  }

  .hero__media--slideshow .hero__slide--leaving {
    opacity: 0;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    height: 45%;
    pointer-events: none;
    background: color-mix(in srgb, var(--c-bg-dark) 50%, transparent);
    -webkit-backdrop-filter: blur(0.75rem);
    backdrop-filter: blur(0.75rem);
    -webkit-mask-image: linear-gradient(#0000, #000000c7 80%, #000 100%);
    mask-image: linear-gradient(#0000, #000000c7 80%, #000 100%);
  }

  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: cover;
    object-position: bottom;
    user-select: none;
  }

  .hero__content {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(17.5rem, 1fr);
    gap: var(--space-16) clamp(var(--space-8), 5vw, var(--space-16));
    align-items: end;
    padding-inline: var(--gutter);
    padding-bottom: clamp(var(--space-12), 8vh, var(--space-24));
  }

  .hero__aside {
    grid-column: 2;
  }

  :global(.hero__brand) {
    display: block;
    width: clamp(50%, 50vw, 30rem);
    height: auto;
  }

  .hero__aside :global(.arrow-link) {
    margin-top: var(--space-6);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media--slideshow .hero__slide {
      transition: none;
    }

    .hero__media--slideshow .hero__slide:first-child {
      opacity: 1;
    }
  }

  @media (width >= 769px) {
    :global(.hero__brand) {
      padding-left: var(--space-8);
    }
  }

  @media (max-width: 768px) {
    .hero__content {
      grid-template-columns: 1fr;
      padding-bottom: var(--space-8);
    }

    .hero__aside {
      grid-column: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
