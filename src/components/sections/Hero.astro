---
import ArrowLink from '../ArrowLink.astro';
import { plNoBreak } from '../../utils/typography';

interface Props {
  title?: string;
  titleStart?: string;
  titleEnd?: string;
  text?: string;
  img?: string;
}

const {
  title = 'Tworzę architekturę.\nInspiruję się miejscem i ludźmi',
  titleStart,
  titleEnd,
  text = 'Od pierwszej idei po dokumentację i realizację prowadzimy inwestora przez cały proces projektowy',
  img = '/img/tm-1.jpg',
} = Astro.props;
---

<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <img
      src={img}
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero__content">
    <h1 class="hero__title">
      {titleStart && titleEnd ? (
        <>{plNoBreak(titleStart)}<span class="hero__star">*</span>{plNoBreak(titleEnd)}</>
      ) : plNoBreak(title)}
    </h1>
    <div class="hero__aside">
      <p class="hero__note">{plNoBreak(text)}</p>
      <ArrowLink href="/#kontakt">Umów spotkanie z&nbsp;architektem</ArrowLink>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 620px;
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.1);
  }

  .hero__media img {
    width: 100%;
    height: 111.111%;
    object-fit: cover;
    transform: translateY(-10%);
  }

  /* Nagłówek i dopisek stoją w jednym rzędzie, oba dosunięte do dołu:
     nagłówek do lewej, dopisek do prawej krawędzi komponentu.
     Padding dolny równy bocznym. */
  .hero__content {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding-inline: var(--gutter);
    padding-bottom: clamp(48px, 8vh, 90px);
  }

  .hero__title {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.7rem, 5.2vw, 6.4rem);
    line-height: 1.02;
    /* nagłówek łamiemy ręcznie znakami nowej linii z propsa */
    white-space: pre-line;
    letter-spacing: -0.03em;
    font-weight: 500;
  }

  .hero__aside {
    max-width: 39ch;
    text-align: right;
  }

  .hero__star {
    color: var(--c-accent);
  }

  .hero__note {
    font-family: var(--ff-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
  }

  .hero__aside :global(.arrow-link) {
    margin-top: 24px;
  }

  @media (max-width: 768px) {

    /* na wąskim ekranie dopisek schodzi pod nagłówek */
    .hero__content {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding-bottom: 36px;
    }

    .hero__aside {
      text-align: left;
    }

    .hero__title {
      font-size: clamp(2.6rem, 12vw, 4.5rem);
    }
  }
</style>
