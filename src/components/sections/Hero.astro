---
import ArrowLink from '../ArrowLink.astro';

// Hero strony głównej. Zdjęcia przenikają (crossfade + ken burns),
// nagłówek jest stały — nie zmienia się razem ze slajdami.
interface Props {
  // nagłówek rozbity na części, bo gwiazdka w środku ma własny kolor
  titleStart?: string;
  titleEnd?: string;
}

const {
  titleStart = 'to',
  titleEnd = 'masz architekta\nod pierwszego szkicu\ndo ostatniego detalu',
} = Astro.props;

const slides = ['/img/tm-1.jpg', '/img/tm-6.jpg', '/img/tm-3.jpg'];

const note =
  'Tomasz Marek — architekt oferujący kompleksową obsługę Twojej inwestycji';

const DURATION = 7; // s na slajd
---

<section
  class="hero"
  style={`--count:${slides.length}; --dur:${DURATION * slides.length}s`}
>
  <div class="hero__slides" aria-hidden="true">
    {
      slides.map((img, i) => (
        <div class="hero__slide" style={`--i:${i}`}>
          <img
            src={img}
            alt=""
            width="1920"
            height="1080"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </div>
      ))
    }
  </div>

  <div class="hero__content">
    <h1 class="hero__title">{titleStart}<span class="hero__star">*</span>{titleEnd}</h1>
    <p class="hero__note">
      {note}{' '}
      <ArrowLink href="/#kontakt">
        Umów konsultację
      </ArrowLink>
    </p>
  </div>

</section>

<style>
  .hero {
    position: relative;
    height: var(--hero-h);
    min-height: 420px;
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  .hero__slides {
    position: absolute;
    inset: 0;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: hero-fade var(--dur) infinite;
    animation-delay: calc(var(--i) * (var(--dur) / var(--count)));
  }

  .hero__slide:first-child {
    opacity: 1;
  }

  .hero__slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
  }

  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-zoom var(--dur) infinite;
    animation-delay: calc(var(--i) * (var(--dur) / var(--count)));
  }

  /* Nagłówek i dopisek stoją w jednym rzędzie, oba dosunięte do dołu:
     nagłówek do lewej, dopisek do prawej krawędzi komponentu.
     Padding dolny równy bocznym. */
  .hero__content {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding-inline: var(--gutter);
    padding-bottom: var(--pad-x);
  }

  .hero__title {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.5rem, 4vw, 5.5rem);
    line-height: 1.02;
    /* nagłówek łamiemy ręcznie znakami nowej linii z propsa */
    white-space: pre-line;
    letter-spacing: -0.03em;
    font-weight: 500;
  }

  .hero__star {
    color: var(--c-accent);
  }

  .hero__note {
    flex-shrink: 0;
    max-width: 35ch;
    /* wyrównanie do linii bazowej ostatniego wiersza nagłówka */
    margin-bottom: 0.15em;
    font-family: var(--ff-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    text-align: right;
  }

  /* 3 slajdy → 33.33% na slajd, ~4% na przenikanie */
  @keyframes hero-fade {
    0% {
      opacity: 0;
    }
    2%,
    31% {
      opacity: 1;
    }
    35%,
    100% {
      opacity: 0;
    }
  }

  @keyframes hero-zoom {
    0% {
      transform: scale(1);
    }
    35%,
    100% {
      transform: scale(1.1);
    }
  }

  @media (max-width: 768px) {

    /* na wąskim ekranie dopisek schodzi pod nagłówek */
    .hero__content {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .hero__note {
      margin-bottom: 0;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      animation: none;
    }

    .hero__slide:not(:first-child) {
      display: none;
    }

    .hero__slide img {
      animation: none;
    }
  }
</style>
