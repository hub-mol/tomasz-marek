---
import ArrowLink from '../ArrowLink.astro';
import BrandLogo from '../BrandLogo.astro';
import { plNoBreak } from '../../utils/typography';
import heroImage from '../../assets/images/hero-0.jpg';
import ProjectImage from '../ProjectImage.astro';
import type {ProjectImage as ProjectImageType} from '../../data/portfolio';

interface Props {
  title?: string;
  showTitle?: boolean;
  titleStart?: string;
  titleEnd?: string;
  text?: string;
  img?: ProjectImageType;
  images?: ProjectImageType[];
  alt?: string;
}

const {
  title = 'Architektura zainspirowana miejscem i ludźmi.',
  showTitle = false,
  titleStart,
  titleEnd,
  text = 'Od idei po realizację poprowadzimy Cię przez cały proces projektowy i wykonawczy.',
  img = heroImage,
  images,
  alt = 'Wizualizacja projektu architektonicznego autorstwa Tomasza Marka',
} = Astro.props;

const slides = images?.length ? images.slice(0, 3) : [img];
---

<section class="hero">
  <div class:list={['hero__media', {'hero__media--slideshow': slides.length > 1}]} aria-hidden="true">
    {slides.map((slide, index) => (
      <div class="hero__slide" style={`--slide-index: ${index}; --slide-count: ${slides.length};`}>
        <ProjectImage
          image={slide}
          alt={slide && 'alt' in slide ? slide.alt ?? alt : alt}
          widths={[768, 1280, 1920, 2400]}
          sizes="100vw"
          format="avif"
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
      </div>
    ))}
  </div>

  <div class="hero__content">
    {showTitle ? (
      <h1 class="hero__title type-h1">
        {titleStart && titleEnd ? (
          <>{plNoBreak(titleStart)}<span class="hero__star">*</span>{plNoBreak(titleEnd)}</>
        ) : plNoBreak(title)}
      </h1>
    ) : (
      <BrandLogo class="hero__brand" />
    )}
    <div class="hero__aside">
      <p class="hero__note type-heading-lg">{plNoBreak(text)}</p>
      <ArrowLink href="/#kontakt">Umów konsultację z&nbsp;architektem</ArrowLink>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 38.75rem;
    overflow: hidden;
    background: var(--c-bg-dark);
    color: var(--c-on-dark);
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
  }

  .hero__media--slideshow .hero__slide {
    opacity: 0;
    animation: hero-crossfade calc(var(--slide-count) * 6s) infinite;
    animation-delay: calc(var(--slide-index) * 6s);
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--c-bg-dark) 10%, transparent);
  }

  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: cover;
    object-position: bottom;
    user-select: none;
  }

  .hero__content {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(17.5rem, 1fr);
    gap: var(--space-16) clamp(var(--space-8), 5vw, var(--space-16));
    align-items: end;
    padding-inline: var(--gutter);
    padding-bottom: clamp(var(--space-12), 8vh, var(--space-24));
  }

  .hero__title {
    max-width: 18ch;
    margin: 0;
    /* nagłówek łamiemy ręcznie znakami nowej linii z propsa */
    white-space: pre-line;
  }

  .hero__aside {
    grid-column: 2;
  }

  :global(.hero__brand) {
    display: block;
    width: clamp(50%, 50vw, 10rem);
    height: auto;
  }

  .hero__star {
    color: var(--c-accent);
  }

  .hero__aside :global(.arrow-link) {
    margin-top: var(--space-6);
  }

  @keyframes hero-crossfade {
    0%, 28% { opacity: 1; }
    34%, 94% { opacity: 0; }
    100% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media--slideshow .hero__slide {
      animation: none;
    }

    .hero__media--slideshow .hero__slide:first-child {
      opacity: 1;
    }
  }

  @media (width >= 769px) {
    :global(.hero__brand) {
      padding-top: var(--space-8);
    }
  }

  @media (max-width: 768px) {
    .hero__content {
      grid-template-columns: 1fr;
      padding-bottom: var(--space-8);
    }

    .hero__aside {
      grid-column: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
