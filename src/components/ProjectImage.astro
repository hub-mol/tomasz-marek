---
import {Image} from 'astro:assets'
import type {ProjectImage} from '../data/portfolio'
import {getSanityImageSources} from '../lib/sanityImage'

interface Props {
  image: ProjectImage
  alt: string
  widths: number[]
  sizes: string
  format?: 'avif' | 'webp' | 'png' | 'jpg' | 'jpeg'
  loading?: 'eager' | 'lazy'
  fetchpriority?: 'high' | 'low' | 'auto'
  decoding?: 'sync' | 'async' | 'auto'
}

const {
  image,
  alt,
  widths,
  sizes,
  format = 'avif',
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
} = Astro.props
const isSanityImage = 'url' in image
const sanitySources = isSanityImage
  ? getSanityImageSources(image.url, image.width, widths)
  : {src: '', srcset: ''}
---

{isSanityImage ? (
  <img
    src={sanitySources.src}
    srcset={sanitySources.srcset}
    width={image.width}
    height={image.height}
    alt={image.alt ?? alt}
    sizes={sizes}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding={decoding}
  />
) : (
  <Image
    src={image}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format={format}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding={decoding}
  />
)}
