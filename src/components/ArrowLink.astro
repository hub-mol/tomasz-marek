---
interface Props {
  href: string;
  class?: string;
  ariaLabel?: string;
  typeClass?: string;
}

const { href, class: className, ariaLabel, typeClass = 'type-heading-lg' } = Astro.props;
---

<a class:list={['arrow-link', typeClass, className]} href={href} aria-label={ariaLabel}>
  <span class="arrow-link__label"><slot /></span>
  <svg
    class="arrow-link__arrow"
    width="16"
    height="16"
    viewBox="0 0 16 16"
    aria-hidden="true"
  >
    <path d="M1.25 14.75 14.75 1.25" />
    <path d="M4.125 1.25H14.75v10.625" />
  </svg>
</a>

<style>
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    width: fit-content;
    color: inherit;
    transition: color 0.3s ease;
  }

  .arrow-link__arrow {
    flex: 0 0 auto;
    width: 0.66em;
    height: 100%;
    padding-top: 0.2em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5px;
    stroke-linejoin: round;
    transition: transform 0.3s cubic-bezier(0.16, 0.48, 0.36, 1);
  }

  .arrow-link:hover {
    color: var(--c-accent);
  }

  .arrow-link:hover .arrow-link__arrow {
    transform: translate(2px, -2px);
  }
</style>
