---
interface Props {
  href: string;
  class?: string;
  ariaLabel?: string;
}

const { href, class: className, ariaLabel } = Astro.props;
---

<a class:list={['arrow-link', className]} href={href} aria-label={ariaLabel}>
  <span class="arrow-link__label"><slot /></span>
  <svg
    class="arrow-link__arrow"
    width="16"
    height="16"
    viewBox="0 0 16 16"
    aria-hidden="true"
  >
    <path d="M4.5 13.5 11.5 6.5" />
    <path d="M5.75 6.5h5.75v5.75" />
  </svg>
</a>

<style>
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    width: fit-content;
    color: inherit;
    line-height: 1.35;
    transition: color 0.3s ease;
  }

  .arrow-link__label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.32em;
  }

  .arrow-link__arrow {
    flex: 0 0 auto;
    width: 1.15em;
    height: 1.15em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1px;
    transition: transform 0.3s cubic-bezier(0.16, 0.48, 0.36, 1);
  }

  .arrow-link__arrow path {
    vector-effect: non-scaling-stroke;
  }

  .arrow-link:hover {
    color: var(--c-accent);
  }

  .arrow-link:hover .arrow-link__arrow {
    transform: translate(2px, -2px);
  }
</style>
